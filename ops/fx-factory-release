#!/bin/bash
# Собирает Фабрику из git и выкатывает сервер и воркер одной ревизией.
set -uo pipefail

ref="${1:-main}"

# Под systemd у службы нет $HOME, а factory-server требует домашнюю папку даже
# при явном -database (шаг snapshot). Автопоезд запускает выпуск именно как
# службу, поэтому выпуск обязан работать без унаследованного окружения.
if [ -z "${HOME:-}" ]; then
  HOME=$(getent passwd "$(id -u)" | cut -d: -f6)
  [ -n "$HOME" ] || HOME=/root
  export HOME
fi

# Бортовой журнал рейса: когда выпуск запущен посредником (есть id операции),
# весь вывод дублируется в файл — иначе упавший самоходный рейс не оставляет
# ни строчки (посредник глушит stdout), и причина провала неизвестна.
if [ -n "${FACTORY_DELIVERY_ID:-}" ] && [ -z "${FACTORY_RELEASE_LOG_ACTIVE:-}" ]; then
  export FACTORY_RELEASE_LOG_ACTIVE=1
  _voyage_log_dir="${FACTORY_RELEASE_VOYAGE_LOG_DIR:-/var/lib/factory/release-broker}"
  _voyage_log="$_voyage_log_dir/voyage-${FACTORY_DELIVERY_ID//[^A-Za-z0-9._-]/_}.log"
  if mkdir -p -- "$_voyage_log_dir" 2>/dev/null && : >>"$_voyage_log" 2>/dev/null; then
    chmod 600 -- "$_voyage_log" 2>/dev/null || true
    exec > >(tee -a -- "$_voyage_log") 2>&1
  fi
fi

REPO="${FACTORY_RELEASE_REPO:-https://github.com/timafen/factory.git}"
SERVER_BIN="${FACTORY_SERVER_BIN:-/opt/factory-data/bin/factory-server}"
WORKER_BIN="${FACTORY_WORKER_BIN:-/opt/factory-data/bin/factory-worker}"
REL="${FACTORY_RELEASE_DIR:-/opt/factory-data/releases/factory}"
TRUSTED_GATE_PARENT="${FACTORY_RELEASE_TRUSTED_GATE_DIR:-/run/factory-release-gate}"
INFO="${FACTORY_RELEASE_INFO:-/opt/factory-data/releases/factory-current.json}"
OWNER="${FACTORY_RELEASE_OWNER-factory:factory}"
# Смена пользователя — без sudo: выпуск запускает root (в т.ч. из песочницы
# посредника с NoNewPrivileges, где sudo невозможен), а root понижается
# напрямую через setpriv. HOME рабочего пользователя задаётся явно.
if [ "${FACTORY_RELEASE_AS+x}" = x ]; then
  AS="$FACTORY_RELEASE_AS"
else
  release_user="${OWNER%%:*}"
  release_home=$(getent passwd "$release_user" | cut -d: -f6)
  AS="setpriv --reuid $release_user --regid $release_user --init-groups /usr/bin/env HOME=${release_home:-/tmp}"
fi
SERVER_SERVICE="${FACTORY_SERVER_SERVICE:-factory-server.service}"
WORKER_SERVICE="${FACTORY_WORKER_SERVICE:-factory-worker.service}"
WORKER_SERVICES="${FACTORY_WORKER_SERVICES:-$WORKER_SERVICE}"
WORKER_CONFIG="${FACTORY_WORKER_CONFIG:-/opt/factory-data/worker.toml}"
PILOT_SERVICE="${FACTORY_PILOT_SERVICE:-factory-pilot.service}"
INTAKE_SERVICE="${FACTORY_INTAKE_SERVICE:-factory-intake.service}"
API="${FACTORY_API_URL:-http://127.0.0.1:7337}"
REGISTER_ATTEMPTS="${FACTORY_REGISTER_ATTEMPTS:-12}"
REGISTER_DELAY="${FACTORY_REGISTER_DELAY:-5}"
LOCK="${FACTORY_RELEASE_LOCK:-/run/lock/factory-release.lock}"
DATABASE="${FACTORY_DATABASE:-/opt/factory-data/server/factory.sqlite3}"
FX_BIN="${FACTORY_FX_BIN:-/usr/local/bin/fx}"
RELEASE_DRIVER="${FACTORY_RELEASE_DRIVER:-/usr/local/lib/fx-factory-release}"
BROKER_BIN="${FACTORY_RELEASE_BROKER_BIN:-/opt/factory-data/bin/factory-release-broker}"
BROKER_UNIT="${FACTORY_RELEASE_BROKER_UNIT:-/etc/systemd/system/factory-release-broker.service}"
BROKER_DROPIN="${FACTORY_RELEASE_BROKER_PILOT_DROPIN:-/etc/systemd/system/factory-pilot.service.d/50-project-release-broker.conf}"
BROKER_SERVICE="${FACTORY_RELEASE_BROKER_SERVICE:-factory-release-broker.service}"
BROKER_GROUP="${FACTORY_RELEASE_BROKER_GROUP:-factory-release}"
BROKER_OWNER="${FACTORY_RELEASE_BROKER_OWNER-root:root}"
CONTROL_OWNER="${FACTORY_CONTROL_OWNER-root:root}"
BRAIN_OWNER="${FACTORY_BRAIN_OWNER-factory:factory}"
BRAIN_LIVE="${FACTORY_BRAIN_LIVE:-/opt/factory-data}"
BROWSER_RUNTIME_ROOT="${FACTORY_BROWSER_RUNTIME_ROOT:-$REL/browser-runtime}"
BROWSER_RUNTIME_CURRENT="$BROWSER_RUNTIME_ROOT/current"
BROWSER_RUNTIME_GENERATIONS="$BROWSER_RUNTIME_ROOT/generations"
old_browser_current=''
browser_published=0
browser_stage=''
browser_rollback=''
browser_restore_required=0
BROWSER_LAUNCHER="${FACTORY_BROWSER_LAUNCHER:-/usr/local/libexec/factory/factory-browser-sandbox}"
BROWSER_HELPER="${FACTORY_BROWSER_HELPER:-/usr/local/libexec/factory/factory-browser-isolated}"
BROWSER_CONFIG="${FACTORY_BROWSER_CONFIG:-/usr/local/libexec/factory/factory-browser.conf}"
BROWSER_STATE="${FACTORY_BROWSER_INSTALL_STATE:-/usr/local/libexec/factory/factory-browser-install.state}"
BROWSER_SUDOERS="${FACTORY_BROWSER_SUDOERS:-/etc/sudoers.d/factory-browser}"
BROWSER_APPARMOR="${FACTORY_BROWSER_APPARMOR:-/etc/apparmor.d/factory-browser}"
BROWSER_READINESS_MARKER="${FACTORY_BROWSER_READINESS_MARKER:-$BRAIN_LIVE/pilot/browser-readiness.json}"
GENERATIONS="$REL/generations"
CURRENT="$REL/current"
PREVIOUS="$REL/previous"
JOURNAL="$REL/transaction"
GATE_READY_ATTEMPTS="${FACTORY_RELEASE_GATE_READY_ATTEMPTS:-500}"
GATE_STOP_ATTEMPTS="${FACTORY_RELEASE_GATE_STOP_ATTEMPTS:-100}"
GATE_POLL_DELAY="${FACTORY_RELEASE_GATE_POLL_DELAY:-0.01}"
TRUSTED_OWNER_UID=0
TRUSTED_SETSID=/usr/bin/setsid
TRUSTED_SUDO=/usr/bin/sudo
TRUSTED_BASH=/bin/bash
TRUSTED_STAT=/usr/bin/stat
TRUSTED_MKTEMP=/usr/bin/mktemp
TRUSTED_MV=/usr/bin/mv
TRUSTED_RM=/usr/bin/rm
TRUSTED_SLEEP=/bin/sleep
TRUSTED_OD=/usr/bin/od
TRUSTED_PS=/usr/bin/ps
TRUSTED_AWK=/usr/bin/awk
TRUSTED_NODE=/usr/bin/node
TRUSTED_NPX=/usr/bin/npx
TRUSTED_NPM=/usr/bin/npm
TRUSTED_GO=/usr/bin/go
TRUSTED_PYTHON=/usr/bin/python3
TRUSTED_GIT=/usr/bin/git
TRUSTED_CHMOD=/usr/bin/chmod
TRUSTED_MKDIR=/usr/bin/mkdir

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }
as_user() { if [ -n "$AS" ]; then $AS "$@"; else "$@"; fi; }
as_user_private() {
  # Как as_user, но под umask 077: дерево принадлежит рабочему пользователю
  # и закрыто для посторонних.
  if [ -n "$AS" ]; then
    $AS "$TRUSTED_BASH" -c 'umask 077; exec "$@"' factory-release-private "$@"
  else
    ( umask 077; "$@" )
  fi
}
set_owner() { if [ -n "$OWNER" ]; then chown "$OWNER" "$@"; fi; }
worker_service_list() { printf '%s\n' $WORKER_SERVICES; }
stop_workers() { local service; while read -r service; do systemctl stop "$service" || return; done < <(worker_service_list); }
start_workers() { local service; while read -r service; do systemctl start "$service" || return; done < <(worker_service_list); }
restart_workers() { local service; while read -r service; do systemctl restart "$service" || return; done < <(worker_service_list); }

sync_path() {
  python3 - "$1" <<'PY'
import os,sys
fd=os.open(sys.argv[1], os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY
}

write_journal() { # phase generation previous
  local temporary="$JOURNAL.new"
  umask 077
  printf 'phase=%q\ngeneration=%q\nprevious=%q\n' "$1" "$2" "$3" >"$temporary" \
    && sync_path "$temporary" && mv -f "$temporary" "$JOURNAL" && sync_path "$REL" || return
  if [ "${FACTORY_RELEASE_CRASH_AFTER_PHASE:-}" = "$1" ]; then
    kill -KILL "$$"
  fi
}

read_journal() {
  phase= generation= previous=
  [ ! -e "$JOURNAL" ] || . "$JOURNAL"
}

manifest_hash() { sha256sum "$1/manifest.json" | awk '{print $1}'; }

verify_generation() {
  local generation=$1
  [ -d "$generation" ] && [ ! -L "$generation" ] \
    || { fail "поколение выпуска отсутствует или является ссылкой: $generation"; return 1; }
  python3 - "$generation" <<'PY'
import hashlib,json,os,stat,sys
root=sys.argv[1]
manifest_path=os.path.join(root,"manifest.json")
hash_path=os.path.join(root,"manifest.sha256")
try:
    raw=open(manifest_path,"rb").read()
    expected=open(hash_path,encoding="ascii").read().strip()
    if hashlib.sha256(raw).hexdigest()!=expected: raise ValueError("hash manifest")
    data=json.loads(raw)
    if data.get("format")!=1 or not data.get("candidate_sha"): raise ValueError("format manifest")
    for item in data.get("artifacts",[]):
        path=os.path.join(root,item["source"])
        info=os.lstat(path)
        if not stat.S_ISREG(info.st_mode): raise ValueError("not a regular file: "+path)
        body=open(path,"rb").read()
        if len(body)!=item["size"] or hashlib.sha256(body).hexdigest()!=item["sha256"]:
            raise ValueError("artifact hash: "+path)
        if stat.S_IMODE(info.st_mode)!=item["mode"]: raise ValueError("artifact mode: "+path)
    database=data.get("database",{})
    if database.get("snapshot"):
        snapshot=os.path.join(root,database["snapshot"]); marker=snapshot+".v2-control-plane"
        if stat.S_IMODE(os.lstat(snapshot).st_mode)!=0o600 or stat.S_IMODE(os.lstat(marker).st_mode)!=0o600:
            raise ValueError("snapshot mode")
        if hashlib.sha256(open(snapshot,"rb").read()).hexdigest()!=database["sha256"]:
            raise ValueError("snapshot hash")
        if hashlib.sha256(open(marker,"rb").read()).hexdigest()!=database["marker_sha256"]:
            raise ValueError("snapshot marker hash")
except Exception as exc:
    print("!! manifest поколения не прошёл проверку: %s"%exc,file=sys.stderr)
    raise SystemExit(1)
PY
}

service_state() {
  local unit=$1 active=inactive enabled=disabled
  systemctl -q is-active "$unit" 2>/dev/null && active=active || true
  systemctl -q is-enabled "$unit" 2>/dev/null && enabled=enabled || true
  printf '%s:%s' "$active" "$enabled"
}

restore_service_state() {
  local file=$1 unit state active enabled
  [ -r "$file" ] || return 1
  while IFS=$'\t' read -r unit state; do
    # This process is running under the broker cgroup.  Leave the broker
    # untouched for the whole transaction; its caller must first persist the
    # terminal outcome before systemd may recycle it.
    [ "$unit" != "$BROKER_SERVICE" ] || continue
    active=${state%%:*}; enabled=${state#*:}
    [ "$enabled" != enabled ] || systemctl enable "$unit" >/dev/null || return
    [ "$enabled" != disabled ] || systemctl disable "$unit" >/dev/null || return
    [ "$active" != active ] || systemctl start "$unit" || return
    [ "$active" != inactive ] || systemctl stop "$unit" || return
  done <"$file"
}

install_generation() {
  local generation=$1 item source target mode
  verify_generation "$generation" || return
  while IFS=$'\t' read -r source target mode owner; do
    [ -n "$source" ] || continue
    [ "$target" != - ] || continue
    mkdir -p "$(dirname "$target")" || return
    cp -f "$generation/$source" "$target.new" \
      && { [ -z "$owner" ] || chown "$owner" "$target.new"; } \
      && chmod "$mode" "$target.new" && sync_path "$target.new" && mv -f "$target.new" "$target" \
      && sync_path "$(dirname "$target")" || return
  done < <(python3 - "$generation/manifest.json" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1]))["artifacts"]:
 print("%s\t%s\t%o\t%s"%(x["source"],x["target"],x["mode"],x.get("owner","")))
PY
  )
  systemctl daemon-reload || return
}

stop_factory_units() {
  local unit
  while read -r unit; do systemctl stop "$unit" || return; done < <(worker_service_list)
  systemctl stop "$PILOT_SERVICE" 2>/dev/null || true
  systemctl stop "$INTAKE_SERVICE" 2>/dev/null || true
  # The driver is a child of the broker service.  Stopping the broker here
  # would make systemd KillMode=control-group kill this release before it can
  # persist the terminal result.  The broker stays up until its caller exits.
  systemctl stop "$SERVER_SERVICE"
}

verify_generation_runtime() {
  local selected=$1 unit pid exe worker_id body previous_body previous_heartbeat registered attempt
  if systemctl -q is-active "$SERVER_SERVICE" 2>/dev/null; then
    pid=$(systemctl show -p MainPID --value "$SERVER_SERVICE" 2>/dev/null)
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    [ "$exe" = "$SERVER_BIN" ] \
      && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$selected/payload/factory-server" | awk '{print $1}')" ] \
      || { fail "запущенный server не совпадает с выбранным manifest"; return 1; }
    [ "$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)" = 200 ] \
      || { fail "server выбранного поколения не прошёл health"; return 1; }
  fi
  for unit in $(worker_service_list); do
    systemctl -q is-active "$unit" 2>/dev/null || continue
    pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    [ "$exe" = "$WORKER_BIN" ] \
      && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$selected/payload/factory-worker" | awk '{print $1}')" ] \
      || { fail "запущенный $unit не совпадает с выбранным manifest"; return 1; }
  done
  if systemctl -q is-active "$WORKER_SERVICE" 2>/dev/null; then
    # The identity command deliberately locks the worker data directory. It
    # cannot run beside the live worker that owns that lock, so a recovery
    # verification must obtain the identity while the primary worker is
    # stopped and then prove that the restarted process registered freshly.
    systemctl stop "$WORKER_SERVICE" || return
    worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>/dev/null) \
      || { systemctl start "$WORKER_SERVICE" >/dev/null 2>&1 || true; return 1; }
    previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
    previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("last_heartbeat", ""))
except Exception: print("")' 2>/dev/null || true)
    systemctl start "$WORKER_SERVICE" || return
    registered=0
    for ((attempt=1; attempt<=REGISTER_ATTEMPTS; attempt++)); do
      body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
      if printf '%s' "$body" | python3 -c 'import datetime,json,sys
try:
 w=json.load(sys.stdin); h=w.get("last_heartbeat", ""); old=sys.argv[2]
 parsed=datetime.datetime.fromisoformat(h.replace("Z","+00:00")); now=datetime.datetime.now(datetime.timezone.utc)
 ok=w.get("id")==sys.argv[1] and w.get("health")=="healthy" and w.get("online") is True and h and (not old or h>old) and 0 <= (now-parsed).total_seconds() <= 120
except Exception: ok=False
raise SystemExit(not ok)' "$worker_id" "$previous_heartbeat"; then registered=1; break; fi
      sleep "$REGISTER_DELAY"
    done
    [ "$registered" = 1 ] \
      || { fail "worker выбранного поколения не зарегистрировался свежим и healthy"; return 1; }
  fi
}

database_ledger() {
  python3 - "$1" <<'PY'
import sqlite3,sys
db=sqlite3.connect("file:"+sys.argv[1]+"?mode=ro",uri=True)
values=[x[0] for x in db.execute("select version from schema_migrations order by version")]
if values!=list(range(1,len(values)+1)): raise SystemExit("ledger миграций имеет разрыв")
print(values[-1] if values else 0)
PY
}

rollback_to_generation() { # generation, owner-facing reason
  local target=$1 reason=$2 live_ledger generation_ledger
  fail "$reason — возвращаю полный прежний комплект"
  stop_factory_units || true
  install_generation "$target" || { fail "полный комплект не восстановлен; journal оставлен: $JOURNAL"; return 1; }
  cp -f "$target/release-info.json" "$INFO.new" && set_owner "$INFO.new" && chmod 600 "$INFO.new" \
    && sync_path "$INFO.new" && mv -f "$INFO.new" "$INFO" && sync_path "$(dirname "$INFO")" || return
  live_ledger=$(database_ledger "$DATABASE") || return
  generation_ledger=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("database",{}).get("ledger",-1))' "$target/manifest.json")
  if [ "$generation_ledger" -ge 0 ] && [ "$live_ledger" -gt "$generation_ledger" ]; then
    [ -z "${previous:-}" ] || { ln -sfn "$previous" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"; }
    ln -sfn "$target" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
    write_journal db_restore_required "$target" "${previous:-}"
    fail "код возвращён, но база новее ($live_ledger > $generation_ledger); службы остановлены. Выполните отдельный fx factory restore-db"
    return 9
  fi
  restore_service_state "$target/services.tsv" || return
  verify_generation_runtime "$target" || { fail "проверка полного отката не завершена; journal оставлен"; return 1; }
  ln -sfn "$target" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
  if [ ! -e "$PREVIOUS" ] && [ ! -L "$PREVIOUS" ]; then
    ln -sfn "$target" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS" || return
  fi
  rm -f "$JOURNAL"
  sync_path "$REL"
}

snapshot_browser_runtime() {
  local target name
  browser_rollback=$(mktemp -d "$BROWSER_RUNTIME_ROOT/.rollback-$sha.XXXXXX") || return 1
  for target in "$BROWSER_LAUNCHER" "$BROWSER_HELPER" "$BROWSER_CONFIG" "$BROWSER_STATE" "$BROWSER_SUDOERS" "$BROWSER_APPARMOR" "$BROWSER_READINESS_MARKER"; do
    name=$(printf '%s' "$target" | sha256sum | awk '{print $1}')
    [ ! -e "$target" ] && [ ! -L "$target" ] || cp -a -- "$target" "$browser_rollback/$name" || return 1
  done
}

restore_browser_runtime() {
  local target name
  [ -n "$browser_rollback" ] && [ -d "$browser_rollback" ] || return 0
  for target in "$BROWSER_LAUNCHER" "$BROWSER_HELPER" "$BROWSER_CONFIG" "$BROWSER_STATE" "$BROWSER_SUDOERS" "$BROWSER_APPARMOR" "$BROWSER_READINESS_MARKER"; do
    name=$(printf '%s' "$target" | sha256sum | awk '{print $1}')
    rm -f -- "$target" "$target.new"
    [ ! -e "$browser_rollback/$name" ] && [ ! -L "$browser_rollback/$name" ] || cp -a -- "$browser_rollback/$name" "$target" || return 1
  done
}

verify_browser_runtime() { # generation
  local generation=$1 browser fingerprint
  [ -d "$generation/web/node_modules/playwright" ] || return 1
  browser=$(cd "$generation/web" && /usr/bin/node -e 'process.stdout.write(require("playwright").chromium.executablePath())') || return 1
  [ -x "$browser" ] || { fail "Chromium browser executable отсутствует: $browser"; return 1; }
  [ -x "$BROWSER_LAUNCHER" ] && [ -x "$BROWSER_HELPER" ] \
    && [ -f "$BROWSER_CONFIG" ] && [ -f "$BROWSER_STATE" ] && [ -f "$BROWSER_READINESS_MARKER" ] \
    || { fail "browser launcher, config, state или readiness marker отсутствует"; return 1; }
  fingerprint=$(sha256sum "$browser" | awk '{print $1}')
  grep -Fx "browser_sha=$fingerprint" "$BROWSER_STATE" >/dev/null \
    && python3 - "$BROWSER_READINESS_MARKER" "$fingerprint" <<'PY'
import json,sys
with open(sys.argv[1]) as f: marker=json.load(f)
raise SystemExit(marker.get("browser_fingerprint") != sys.argv[2])
PY
}
case "$GATE_READY_ATTEMPTS:$GATE_STOP_ATTEMPTS" in
  *[!0-9:]*|:*|*:) fail "некорректный лимит ожидания test gate"; exit 4 ;;
esac

validate_trusted_executable() { # validate_trusted_executable <absolute path>
  local executable=$1 owner mode
  case "$executable" in /*) ;; *) return 1 ;; esac
  [ -f "$executable" ] && [ -x "$executable" ] || return 1
  owner=$("$TRUSTED_STAT" -Lc %u -- "$executable" 2>/dev/null) || return 1
  mode=$("$TRUSTED_STAT" -Lc %a -- "$executable" 2>/dev/null) || return 1
  [ "$owner" = "$TRUSTED_OWNER_UID" ] || return 1
  (( (8#$mode & 0022) == 0 ))
}

for trusted_executable in "$TRUSTED_STAT" "$TRUSTED_SETSID" "$TRUSTED_SUDO" \
  "$TRUSTED_BASH" "$TRUSTED_MKTEMP" "$TRUSTED_MV" "$TRUSTED_RM" \
  "$TRUSTED_SLEEP" "$TRUSTED_OD" "$TRUSTED_PS" "$TRUSTED_AWK" "$TRUSTED_NODE" \
  "$TRUSTED_NPX" "$TRUSTED_NPM" "$TRUSTED_GO" "$TRUSTED_GIT" "$TRUSTED_CHMOD" \
  "$TRUSTED_MKDIR"; do
  validate_trusted_executable "$trusted_executable" \
    || { fail "нет доверенного executable для test gate: $trusted_executable"; exit 4; }
done

# $AS is intentionally not accepted here. It is a convenience wrapper for
# workspace operations and may be supplied by the caller, so it cannot be in
# the trust chain that reports a gate result. The gate identity instead comes
# from OWNER and is entered through one fixed, root-owned launcher whose wait
# status is authoritative. OWNER='' is the explicit no-switch mode used by the
# hermetic test fixture (and by an operator already running as the target UID).
gate_identity=()
if [ -n "$OWNER" ]; then
  gate_user=${OWNER%%:*}
  if ! [[ "$gate_user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    fail "некорректный пользователь для test gate"
    exit 4
  fi
  gate_identity=("$TRUSTED_SUDO" -H -u "$gate_user" --)
fi

preflight_fail() {
  fail "выпуск остановлен: $1; живую metadata не исправляли автоматически — для выпуска нужна проверенная восстановимая исходная точка"
}

path_is_present() { [ -e "$1" ] || [ -L "$1" ]; }

validate_release_history() {
  local current_present=0 previous_present=0 first_generation='' candidate generations_real
  bootstrap_release=0
  current_generation=''
  previous_generation=''

  if path_is_present "$REL"; then
    [ -d "$REL" ] && [ ! -L "$REL" ] \
      || { preflight_fail "каталог выпусков повреждён или является ссылкой: $REL"; return 1; }
    [ $((8#$(stat -c %a "$REL") & 8#022)) -eq 0 ] \
      || { preflight_fail "каталог выпусков доступен для записи группе или другим: $REL"; return 1; }
  fi
  if path_is_present "$GENERATIONS"; then
    [ -d "$GENERATIONS" ] && [ ! -L "$GENERATIONS" ] \
      || { preflight_fail "история поколений повреждена или является ссылкой: $GENERATIONS"; return 1; }
    [ $((8#$(stat -c %a "$GENERATIONS") & 8#022)) -eq 0 ] \
      || { preflight_fail "история поколений доступна для записи группе или другим: $GENERATIONS"; return 1; }
  fi
  path_is_present "$CURRENT" && current_present=1
  path_is_present "$PREVIOUS" && previous_present=1

  if [ "$current_present" = 0 ] && [ "$previous_present" = 0 ]; then
    if [ -d "$GENERATIONS" ]; then
      first_generation=$(find "$GENERATIONS" -mindepth 1 -maxdepth 1 -print -quit)
      [ -z "$first_generation" ] \
        || { preflight_fail "в пустой истории найдено непроверенное поколение: $first_generation"; return 1; }
    fi
    bootstrap_release=1
    return 0
  fi

  [ "$current_present" = 1 ] && [ "$previous_present" = 1 ] \
    && [ -L "$CURRENT" ] && [ -L "$PREVIOUS" ] \
    || { preflight_fail "обнаружена частичная история current/previous"; return 1; }
  [ -d "$GENERATIONS" ] && [ ! -L "$GENERATIONS" ] \
    || { preflight_fail "ссылки current/previous есть, но истории поколений нет"; return 1; }

  generations_real=$(readlink -f "$GENERATIONS" 2>/dev/null || true)
  current_generation=$(readlink -f "$CURRENT" 2>/dev/null || true)
  previous_generation=$(readlink -f "$PREVIOUS" 2>/dev/null || true)
  [ -n "$generations_real" ] && [ -n "$current_generation" ] && [ -n "$previous_generation" ] \
    && [ "$(dirname "$current_generation")" = "$generations_real" ] \
    && [ "$(dirname "$previous_generation")" = "$generations_real" ] \
    || { preflight_fail "ссылки current/previous не указывают на опубликованные поколения"; return 1; }

  for candidate in "$current_generation" "$previous_generation"; do
    [ -d "$candidate" ] && [ ! -L "$candidate" ] && verify_generation "$candidate" \
      || { preflight_fail "ссылки current/previous не указывают на проверенные поколения"; return 1; }
  done

  while IFS= read -r -d '' candidate; do
    [ -d "$candidate" ] && [ ! -L "$candidate" ] \
      || { preflight_fail "в истории есть неатомарное поколение: $candidate"; return 1; }
    verify_generation "$candidate" \
      || { preflight_fail "в истории есть непроверенное поколение: $candidate"; return 1; }
  done < <(find "$generations_real" -mindepth 1 -maxdepth 1 -print0)
}

validate_live_rollback_kit() {
  local path expected expected_owner metadata
  local -a metadata_parts
  for path in "$SERVER_BIN" "$WORKER_BIN" "$FX_BIN" "$RELEASE_DRIVER" "$BROKER_BIN" "$BROKER_UNIT" "$BROKER_DROPIN" \
    "$BRAIN_LIVE/pilot/pilot.py" "$BRAIN_LIVE/pilot/context.md" \
    "$BRAIN_LIVE/intake/app.py" "$BRAIN_LIVE/intake/plan.py" "$DATABASE" "$INFO"; do
    [ -f "$path" ] && [ ! -L "$path" ] \
      || { preflight_fail "нет полного rollback artifact: $path"; return 1; }
  done
  for path in "$SERVER_BIN" "$WORKER_BIN" "$FX_BIN" "$RELEASE_DRIVER" "$BROKER_BIN"; do
    [ "$(stat -c %a "$path")" = 755 ] \
      || { preflight_fail "неверный mode rollback artifact: $path"; return 1; }
    if [ -n "$OWNER" ] && [ "$path" = "$SERVER_BIN" -o "$path" = "$WORKER_BIN" ]; then
      [ "$(stat -c %U:%G "$path")" = "$OWNER" ] \
        || { preflight_fail "неверный owner rollback artifact: $path"; return 1; }
    fi
  done
  for expected in \
    "$SERVER_BIN|$OWNER" "$WORKER_BIN|$OWNER" "$BROKER_BIN|$BROKER_OWNER" \
    "$BROKER_UNIT|$BROKER_OWNER" "$BROKER_DROPIN|$BROKER_OWNER" \
    "$FX_BIN|$CONTROL_OWNER" "$RELEASE_DRIVER|$CONTROL_OWNER" \
    "$BRAIN_LIVE/pilot/pilot.py|$BRAIN_OWNER" "$BRAIN_LIVE/pilot/context.md|$BRAIN_OWNER" \
    "$BRAIN_LIVE/intake/app.py|$BRAIN_OWNER" "$BRAIN_LIVE/intake/plan.py|$BRAIN_OWNER" \
    "$INFO|$OWNER"; do
    path=${expected%%|*}; expected_owner=${expected#*|}
    [ -z "$expected_owner" ] || [ "$(stat -c %U:%G "$path")" = "$expected_owner" ] \
      || { preflight_fail "неверный owner rollback artifact: $path"; return 1; }
  done
  for path in "$BROKER_UNIT" "$BROKER_DROPIN" "$BRAIN_LIVE/pilot/pilot.py" \
    "$BRAIN_LIVE/pilot/context.md" "$BRAIN_LIVE/intake/app.py" "$BRAIN_LIVE/intake/plan.py"; do
    [ "$(stat -c %a "$path")" = 644 ] \
      || { preflight_fail "неверный mode rollback artifact: $path"; return 1; }
  done
  [ "$(stat -c %a "$INFO")" = 600 ] \
    || { preflight_fail "metadata текущего выпуска должна иметь mode 0600: $INFO"; return 1; }
  for path in "$(dirname "$INFO")" "$(dirname "$SERVER_BIN")" "$(dirname "$DATABASE")" \
    "$(dirname "$FX_BIN")" "$BRAIN_LIVE/pilot" "$BRAIN_LIVE/intake"; do
    [ -d "$path" ] && [ ! -L "$path" ] \
      || { preflight_fail "release path должен быть реальным каталогом без symlink: $path"; return 1; }
    [ $((8#$(stat -c %a "$path") & 8#022)) -eq 0 ] \
      || { preflight_fail "release path доступен для записи группе или другим: $path"; return 1; }
  done
  metadata=$(python3 - "$INFO" <<'PY'
import json,re,sys
try:
    data=json.load(open(sys.argv[1]))
    sha=data.get("sha")
    release_id=data.get("release_id")
    if not isinstance(sha,str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?",sha):
        raise ValueError("sha")
    if not isinstance(release_id,str) or not release_id.strip() or any(c in release_id for c in "\r\n\0"):
        raise ValueError("release_id")
    print(sha)
    print(release_id)
except Exception:
    raise SystemExit(1)
PY
  ) || { preflight_fail "release-info не содержит корректные SHA и release_id"; return 1; }
  mapfile -t metadata_parts <<<"$metadata"
  current_sha=${metadata_parts[0]:-}
  current_release_id=${metadata_parts[1]:-}
  server_version=$("$SERVER_BIN" version 2>/dev/null || true)
  worker_version=$("$WORKER_BIN" version 2>/dev/null || true)
  [[ "$server_version" == *"$current_sha"* && "$worker_version" == *"$current_sha"* ]] \
    || { preflight_fail "неизвестный или смешанный выпуск server/worker"; return 1; }
}

mkdir -p "$(dirname "$LOCK")" || { fail "cannot prepare the Factory release lock"; exit 4; }
exec 9>"$LOCK" || { fail "cannot open the Factory release lock"; exit 4; }
flock -n 9 || { fail "another Factory release is already running"; exit 8; }

umask 077

case "$ref" in
  --status)
    read_journal
    current_path=$(readlink -f "$CURRENT" 2>/dev/null || true)
    previous_path=$(readlink -f "$PREVIOUS" 2>/dev/null || true)
    current_sha=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("candidate_sha","?"))' "$current_path/manifest.json" 2>/dev/null || echo '?')
    previous_sha=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("candidate_sha","?"))' "$previous_path/manifest.json" 2>/dev/null || echo '?')
    echo "Factory: current=$current_sha previous=$previous_sha phase=${phase:-нет}"
    [ -z "${generation:-}" ] || echo "manifest=$(manifest_hash "$generation" 2>/dev/null || echo '?') snapshot=$generation/database.sqlite3"
    echo "Pilot остаётся в настроенном состоянии; эта команда ничего не включает"
    exit 0
    ;;
  --rollback)
    target=$(readlink -f "$PREVIOUS" 2>/dev/null || true)
    current_path=$(readlink -f "$CURRENT" 2>/dev/null || true)
    [ -n "$target" ] && verify_generation "$target" || { fail "нет проверенного предыдущего поколения"; exit 4; }
    previous=$current_path
    write_journal prepared "$target" "$current_path" || exit 4
    rollback_to_generation "$target" "откат Factory" || exit $?
    [ -z "$current_path" ] || { ln -sfn "$current_path" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"; }
    echo "== полный откат к $(basename "$target") завершён; база не изменялась"
    exit 0
    ;;
  --restore-db)
    snapshot=${2:-}; expected_manifest=${3:-}; confirmation=${4:-}
    [ -n "$snapshot" ] && [ -n "$expected_manifest" ] \
      || { fail "нужны точный snapshot и hash manifest"; exit 2; }
    generation_path=$(dirname "$snapshot")
    verify_generation "$generation_path" || exit 4
    [ "$(manifest_hash "$generation_path")" = "$expected_manifest" ] \
      || { fail "hash manifest не совпадает"; exit 4; }
    manifest_snapshot=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["database"]["snapshot"])' "$generation_path/manifest.json") \
      || { fail "manifest не содержит snapshot"; exit 4; }
    manifest_snapshot_hash=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["database"]["sha256"])' "$generation_path/manifest.json")
    [ "$snapshot" = "$generation_path/$manifest_snapshot" ] \
      && [ "$(sha256sum "$snapshot" | awk '{print $1}')" = "$manifest_snapshot_hash" ] \
      || { fail "snapshot path/hash не совпадает с manifest"; exit 4; }
    [ "$confirmation" = "RESTORE-FACTORY-DATABASE" ] \
      || { fail "восстановление БД — отдельная опасная операция; добавьте точный token RESTORE-FACTORY-DATABASE"; exit 2; }
    stop_factory_units || { fail "не удалось остановить все Factory-службы"; exit 6; }
    restored="$DATABASE.restore.$$.new"
    failed="$DATABASE.failed.$(date +%Y%m%dT%H%M%S)"
    [ ! -e "$restored" ] && [ ! -e "$failed" ] || { fail "путь восстановления уже существует"; exit 4; }
    "$generation_path/payload/factory-server" -database "$restored" -restore "$snapshot" \
      || { fail "выбранный server не подтвердил восстановленную БД"; exit 6; }
    database_ledger "$restored" >/dev/null || exit 6
    mv "$DATABASE" "$failed" && mv "$DATABASE.v2-control-plane" "$failed.v2-control-plane" \
      && mv "$restored" "$DATABASE" && mv "$restored.v2-control-plane" "$DATABASE.v2-control-plane" \
      || { fail "atomic DB switch не завершён; службы оставлены остановленными"; exit 7; }
    sync_path "$(dirname "$DATABASE")"
    read_journal
    [ "${phase:-}" = db_restore_required ] || { fail "БД восстановлена, но нет ожидающего journal; службы оставлены остановленными"; exit 9; }
    restore_service_state "$generation/services.tsv" || exit 7
    verify_generation_runtime "$generation" || exit 7
    rm -f "$JOURNAL" && sync_path "$REL"
    echo "== БД проверена и восстановлена; прежняя сохранена неизменяемо: $failed"
    exit 0
    ;;
esac

if [ -e "$JOURNAL" ]; then
  read_journal
  case "$phase" in
    committed) rm -f "$JOURNAL" ;;
    db_restore_required) fail "ожидается отдельное восстановление БД; новый выпуск запрещён"; exit 9 ;;
    *) [ -n "$previous" ] || { fail "незавершённый journal без безопасной точки отката"; exit 9; }
       rollback_to_generation "$previous" "восстанавливаю выпуск после прерывания" || exit 9 ;;
  esac
fi

step "проверяю восстановимую исходную точку до сборки"
validate_release_history && validate_live_rollback_kit || exit 4
mkdir -p "$REL" "$GENERATIONS" && chmod 700 "$REL" "$GENERATIONS" && set_owner "$REL" "$GENERATIONS" \
  || { fail "не смог подготовить папку релизов"; exit 4; }
# 711, а не 700: gate script исполняет рабочий пользователь (as_user), ему нужен
# проход по каталогу. Листинг чужим закрыт, файлы внутри root-owned и неизменяемые,
# подлинность каждого дополнительно сверяется git hash-object.
"$TRUSTED_MKDIR" -p -- "$TRUSTED_GATE_PARENT" \
  && "$TRUSTED_CHMOD" 711 -- "$TRUSTED_GATE_PARENT" \
  && [ "$("$TRUSTED_STAT" -Lc %u -- "$TRUSTED_GATE_PARENT")" = "$TRUSTED_OWNER_UID" ] \
  && [ "$("$TRUSTED_STAT" -Lc %a -- "$TRUSTED_GATE_PARENT")" = 711 ] \
  || { fail "не смог подготовить root-owned каталог gate (711: проход без листинга)"; exit 4; }
mkdir -p "$(dirname "$INFO")" && set_owner "$(dirname "$INFO")" \
  || { fail "не смог подготовить release-info"; exit 4; }

work=$(as_user mktemp -d "$REL/build-XXXXXX") \
  || { fail "не смог создать папку сборки"; exit 4; }
gate_pids=()
gate_pgids=()
gate_ready=()
gate_logs=()
gate_names=()
trusted_gate_dir=
test_gates_stopped=1
test_gates_reaped=1
stage=''
bootstrap=''
cleanup() {
  stop_test_gates
  wait_for_test_gates
  [ -z "$stage" ] || rm -rf "$stage"
  [ -z "$bootstrap" ] || rm -rf "$bootstrap"
  if [ "$browser_restore_required" = 1 ]; then
    restore_browser_runtime || true
    if [ -n "$old_browser_current" ] && [ -d "$old_browser_current" ]; then
      ln -sfn "$old_browser_current" "$BROWSER_RUNTIME_CURRENT"
    else
      rm -f -- "$BROWSER_RUNTIME_CURRENT"
    fi
  fi
  [ -z "$trusted_gate_dir" ] || "$TRUSTED_RM" -rf -- "$trusted_gate_dir"
  [ -z "$browser_stage" ] || [ ! -e "$browser_stage" ] || rm -rf -- "$browser_stage"
  [ -z "$browser_rollback" ] || [ ! -e "$browser_rollback" ] || rm -rf -- "$browser_rollback"
  rm -rf "$work"
}
on_release_exit() { cleanup; }
trap on_release_exit EXIT

# UI-проверки и Go-ворота независимы, но установка может начаться только после
# их общего успеха. Реальную SID/PGID сообщает оболочка, уже запущенная через
# setsid: PID внешнего launcher ненадёжен, потому что GNU setsid может forkнуть.
# До атомарной записи handshake сама команда gate не стартует.
# $AS не участвует в запуске gate: равноправный launcher мог бы подменить любой
# файл или канал того же UID. Фиксированный identity launcher и setsid --fork --wait
# образуют waitable-цепочку, чей одноразовый exit status сообщает само ядро.
process_identity() { # process_identity <pid>; sets process_state/ppid/pgid/sid
  local pid=$1 stat rest
  process_state=''
  process_ppid=''
  process_pgid=''
  process_sid=''
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$pid/stat" ] || return 1
  IFS= read -r stat <"/proc/$pid/stat" || return 1
  rest=${stat##*) }
  read -r process_state process_ppid process_pgid process_sid _ <<<"$rest"
  [ "$process_state" != Z ] || return 1
  case "$process_ppid:$process_pgid:$process_sid" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
}

read_test_gate_handshake() { # read_test_gate_handshake <file> <launcher> <nonce>
  local handshake=$1 launcher=$2 expected_nonce=$3
  local sid_field='' pgid_field='' nonce_field='' ready_field='' extra=''
  gate_sid=''
  gate_pgid=''
  [ -s "$handshake" ] || return 1
  IFS=' ' read -r sid_field pgid_field nonce_field ready_field extra <"$handshake" || return 1
  case "$sid_field:$pgid_field:$nonce_field:$ready_field:$extra" in
    sid=*:pgid=*:nonce=*:ready=1:) ;;
    *) return 1 ;;
  esac
  gate_sid=${sid_field#sid=}
  gate_pgid=${pgid_field#pgid=}
  [ "${nonce_field#nonce=}" = "$expected_nonce" ] || return 1
  case "$gate_sid:$gate_pgid" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
  [ "$gate_sid" = "$gate_pgid" ] || return 1
  process_identity "$launcher" || return 1
  process_identity "$gate_sid" || return 1
  # --fork makes the launched setsid process a stable supervisor. Its one
  # direct child must be the live session/process-group leader that published
  # this launch's nonce. A numeric, stale or unrelated process is never ready.
  [ "$process_ppid" = "$launcher" ] \
    && [ "$process_pgid" = "$gate_pgid" ] \
    && [ "$process_sid" = "$gate_sid" ] \
    && test_gate_group_alive "$gate_pgid"
}

publish_test_gate_ack() { # publish_test_gate_ack <file> <nonce>
  local ack=$1 nonce=$2 temporary_ack
  temporary_ack=$($TRUSTED_MKTEMP "${ack}.tmp.XXXXXX") || return 1
  if ! printf 'nonce=%s accepted=1\n' "$nonce" >"$temporary_ack" \
    || ! "$TRUSTED_MV" -f -- "$temporary_ack" "$ack"; then
    "$TRUSTED_RM" -f -- "$temporary_ack"
    return 1
  fi
}

wait_for_test_gate_handshake() { # wait_for_test_gate_handshake <file> <launcher> <nonce> <ack>
  local handshake=$1 launcher=$2 nonce=$3 ack=$4 i
  for ((i = 0; i < GATE_READY_ATTEMPTS; i++)); do
    if read_test_gate_handshake "$handshake" "$launcher" "$nonce"; then
      publish_test_gate_ack "$ack" "$nonce"
      return
    fi
    process_identity "$launcher" || return 1
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  read_test_gate_handshake "$handshake" "$launcher" "$nonce" \
    && publish_test_gate_ack "$ack" "$nonce"
}

test_gate_group_alive() { kill -0 -- "-$1" 2>/dev/null; }

wait_for_test_gate_group_exit() { # wait_for_test_gate_group_exit <pgid>
  local pgid=$1 i
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    test_gate_group_alive "$pgid" || return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  ! test_gate_group_alive "$pgid"
}

wait_for_test_gate_pids_exit() { # wait_for_test_gate_pids_exit <pid...>
  local i pid alive
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    alive=0
    for pid in "$@"; do
      if kill -0 "$pid" 2>/dev/null; then alive=1; break; fi
    done
    [ "$alive" = 0 ] && return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  for pid in "$@"; do
    kill -0 "$pid" 2>/dev/null && return 1
  done
  return 0
}

test_gate_launcher_tree() { # test_gate_launcher_tree <launcher-pid>
  local parent=$1 child
  printf '%s\n' "$parent"
  while read -r child; do
    [ -n "$child" ] || continue
    test_gate_launcher_tree "$child"
  done < <("$TRUSTED_PS" -eo pid=,ppid= \
    | "$TRUSTED_AWK" -v parent="$parent" '$2 == parent {print $1}')
}

reap_test_gate_launcher() { # reap_test_gate_launcher <launcher-pid>
  local launcher=$1
  if ! wait_for_test_gate_pids_exit "$launcher"; then
    kill -KILL "$launcher" 2>/dev/null || true
    wait_for_test_gate_pids_exit "$launcher" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

stop_unready_test_gate_launcher() { # stop_unready_test_gate_launcher <launcher-pid>
  local launcher=$1 i
  local -a tree=()
  mapfile -t tree < <(test_gate_launcher_tree "$launcher")
  for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
    kill -TERM "${tree[$i]}" 2>/dev/null || true
  done
  if ! wait_for_test_gate_pids_exit "${tree[@]}"; then
    for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
      kill -KILL "${tree[$i]}" 2>/dev/null || true
    done
    wait_for_test_gate_pids_exit "${tree[@]}" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

stop_ready_test_gate() { # stop_ready_test_gate <launcher-pid> <pgid>
  local launcher=$1 pgid=$2
  kill -TERM -- "-$pgid" 2>/dev/null || true
  if ! wait_for_test_gate_group_exit "$pgid"; then
    kill -KILL -- "-$pgid" 2>/dev/null || true
    wait_for_test_gate_group_exit "$pgid" || true
  fi
  reap_test_gate_launcher "$launcher"
}

start_test_gate() { # start_test_gate <имя> <журнал> <handshake> <команда...>
  local name=$1 log=$2 handshake=$3 launcher nonce ack
  shift 3
  ack="${handshake}.ack"
  nonce=$("$TRUSTED_OD" -An -N16 -tx1 /dev/urandom) || return 1
  nonce=${nonce//[[:space:]]/}
  [ "${#nonce}" -eq 32 ] || return 1
  "$TRUSTED_RM" -f -- "$handshake" "$ack"
  "$TRUSTED_SETSID" --fork --wait "$TRUSTED_BASH" -c '
    handshake=$1
    ack=$2
    nonce=$3
    poll_delay=$4
    trusted_mktemp=$5
    trusted_mv=$6
    trusted_rm=$7
    trusted_sleep=$8
    shift 8
    trap - HUP INT TERM
    stat=$(<"/proc/$$/stat") || exit 125
    rest=${stat##*) }
    read -r state ppid pgid sid _ <<<"$rest"
    case "$sid:$pgid" in
      *[!0-9:]*|:*|*:) exit 125 ;;
    esac
    [ "$sid" = "$pgid" ] || exit 125
    temporary_handshake=$("$trusted_mktemp" "${handshake}.tmp.XXXXXX") || exit 125
    if ! printf "sid=%s pgid=%s nonce=%s ready=1\\n" "$sid" "$pgid" "$nonce" >"$temporary_handshake" \
      || ! "$trusted_mv" -f -- "$temporary_handshake" "$handshake"; then
      "$trusted_rm" -f -- "$temporary_handshake"
      exit 125
    fi

    accepted=
    for ((i = 0; i < 500; i++)); do
      nonce_field= accepted_field= extra=
      if [ -s "$ack" ]; then
        IFS=" " read -r nonce_field accepted_field extra <"$ack" || true
      fi
      if [ "$nonce_field" = "nonce=$nonce" ] \
        && [ "$accepted_field" = accepted=1 ] && [ -z "$extra" ]; then
        accepted=1
        break
      fi
      "$trusted_sleep" "$poll_delay"
    done
    [ "$accepted" = 1 ] || exit 125

    exec "$@"
  ' "$TRUSTED_BASH" "$handshake" "$ack" "$nonce" "$GATE_POLL_DELAY" \
    "$TRUSTED_MKTEMP" "$TRUSTED_MV" "$TRUSTED_RM" "$TRUSTED_SLEEP" \
    "${gate_identity[@]}" "$@" >"$log" 2>&1 &
  launcher=$!
  gate_pids+=("$launcher")
  gate_pgids+=("")
  gate_ready+=(0)
  gate_logs+=("$log")
  gate_names+=("$name")
  if wait_for_test_gate_handshake "$handshake" "$launcher" "$nonce" "$ack"; then
    gate_pgids[${#gate_pgids[@]}-1]=$gate_pgid
    gate_ready[${#gate_ready[@]}-1]=1
    return 0
  fi
  fail "не дождался handshake реальной session для $name"
  return 1
}

stop_test_gates() {
  local i launcher
  [ "$test_gates_stopped" = 0 ] || return 0
  test_gates_stopped=1
  for i in "${!gate_pids[@]}"; do
    launcher=${gate_pids[$i]}
    if [ "${gate_ready[$i]}" = 1 ]; then
      stop_ready_test_gate "$launcher" "${gate_pgids[$i]}"
    else
      stop_unready_test_gate_launcher "$launcher"
    fi
  done
}

wait_for_test_gates() {
  local launcher
  [ "$test_gates_reaped" = 0 ] || return 0
  for launcher in "${gate_pids[@]}"; do
    reap_test_gate_launcher "$launcher"
  done
  test_gates_reaped=1
}

wait_for_test_gate_descendants() { # wait_for_test_gate_descendants <pgid>
  local pgid=$1
  while test_gate_group_alive "$pgid"; do
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
}

print_test_gate_logs() {
  local i
  for i in "${!gate_logs[@]}"; do
    step "полный вывод: ${gate_names[$i]}"
    cat "${gate_logs[$i]}"
  done
}

on_test_gate_signal() {
  local signal=$1
  trap - HUP INT TERM
  stop_test_gates
  wait_for_test_gates
  print_test_gate_logs
  cleanup
  exit 130
}

run_parallel_test_gates() {
  local completed status failed_name completed_index other_index
  gate_pids=()
  gate_pgids=()
  gate_ready=()
  gate_logs=()
  gate_names=()
  test_gates_stopped=0
  test_gates_reaped=0

  # A shell started as a background job can inherit ignored SIGINT. Reset it
  # before installing our handler so INT follows the same cleanup path.
  trap - HUP INT TERM
  trap 'on_test_gate_signal HUP' HUP
  trap 'on_test_gate_signal INT' INT
  trap 'on_test_gate_signal TERM' TERM

  if ! start_test_gate "UI-проверки" "$work/ui-checks.log" "$work/ui-checks.session" \
    "$TRUSTED_BASH" -c 'cd "$1" && "$2" "$3" tsc -p tsconfig.app.json --noEmit && "$2" "$4" test' \
    "$TRUSTED_BASH" "$work/src/web" "$TRUSTED_NODE" "$TRUSTED_NPX" "$TRUSTED_NPM"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi
  if ! start_test_gate "Go-проверки, тесты пилота и сценарий выката" "$work/go-checks.log" "$work/go-checks.session" \
    "$TRUSTED_BASH" -c 'umask 077; cd "$1" && "$2" test ./... && "$3" -m unittest pilot.test_pilot && "$4" "$5"' \
    "$TRUSTED_BASH" "$work/src" "$TRUSTED_GO" "$TRUSTED_PYTHON" "$TRUSTED_BASH" "$trusted_gate_script"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi

  wait -n -p completed "${gate_pids[@]}"
  status=$?
  if [ "$status" -ne 0 ]; then
    failed_name="параллельная группа проверок"
    if [ "$completed" = "${gate_pids[0]}" ]; then failed_name="${gate_names[0]}"; fi
    if [ "$completed" = "${gate_pids[1]}" ]; then failed_name="${gate_names[1]}"; fi
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "$failed_name завершилась с кодом $status"
    return 1
  fi

  completed_index=1
  [ "$completed" = "${gate_pids[0]}" ] && completed_index=0
  if ! wait_for_test_gate_descendants "${gate_pgids[$completed_index]}"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "не смог подтвердить завершение process group ${gate_names[$completed_index]}"
    return 1
  fi

  other_index=0
  [ "$completed_index" = 0 ] && other_index=1
  wait "${gate_pids[$other_index]}"
  status=$?
  if [ "$status" -eq 0 ] \
    && ! wait_for_test_gate_descendants "${gate_pgids[$other_index]}"; then
    status=1
  fi
  if [ "$status" -ne 0 ]; then
    stop_test_gates
    wait_for_test_gates
    fail "${gate_names[$other_index]} завершилась с кодом $status"
  fi
  trap - HUP INT TERM
  print_test_gate_logs
  if [ "$status" -eq 0 ]; then
    test_gates_stopped=1
    test_gates_reaped=1
  fi
  [ "$status" -eq 0 ]
}

step "беру исходники: $ref"
# Клонирует рабочий пользователь: сборка, npm и ворота идут от его имени и
# обязаны читать дерево. Приватность сохраняет umask 077 внутри as_user_private:
# посторонним (агентам) дерево по-прежнему закрыто. Клон под root ломал
# выпуск на первом же npm ci: рабочий пользователь не мог войти в src/web.
as_user_private "$TRUSTED_GIT" clone --quiet "$REPO" "$work/src" \
  || { fail "не смог забрать репозиторий с GitHub"; cleanup; exit 4; }
as_user_private "$TRUSTED_GIT" -C "$work/src" checkout --quiet -B fx-build "origin/$ref" 2>/dev/null \
  || as_user_private "$TRUSTED_GIT" -C "$work/src" checkout --quiet "$ref" 2>/dev/null \
  || { fail "нет такой точки сборки: $ref"; cleanup; exit 4; }
sha=$("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" rev-parse HEAD) \
  || { fail "не смог определить commit кандидата"; cleanup; exit 4; }
expected_gate_blob=$("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
  rev-parse "$sha:ops/test-fx-factory-release.sh") \
  || { fail "в кандидате нет обязательного gate script"; cleanup; exit 4; }
expected_gate_release_blob=$("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
  rev-parse "$sha:ops/fx-factory-release") \
  || { fail "в кандидате нет обязательного release helper для gate"; cleanup; exit 4; }
trusted_gate_dir=$("$TRUSTED_MKTEMP" -d "$TRUSTED_GATE_PARENT/trusted-gate-XXXXXX") \
  || { fail "не смог создать доверенный каталог gate"; cleanup; exit 4; }
trusted_gate_root="$trusted_gate_dir"
trusted_gate_script="$trusted_gate_root/ops/test-fx-factory-release.sh"
if ! "$TRUSTED_MKDIR" -p -- "$trusted_gate_root/ops/systemd" "$trusted_gate_root/pilot" "$trusted_gate_root/intake" \
  || ! "$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
