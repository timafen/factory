#!/bin/bash
# Собирает Фабрику из git и выкатывает сервер и воркер одной ревизией.
set -uo pipefail

ref="${1:-main}"

# Под systemd у службы нет $HOME, а factory-server требует домашнюю папку даже
# при явном -database (шаг snapshot). Автопоезд запускает выпуск именно как
# службу, поэтому выпуск обязан работать без унаследованного окружения.
if [ -z "${HOME:-}" ]; then
  HOME=$(getent passwd "$(id -u)" | cut -d: -f6)
  [ -n "$HOME" ] || HOME=/root
  export HOME
fi

# Бортовой журнал рейса: когда выпуск запущен посредником (есть id операции),
# весь вывод дублируется в файл — иначе упавший самоходный рейс не оставляет
# ни строчки (посредник глушит stdout), и причина провала неизвестна.
if [ -n "${FACTORY_DELIVERY_ID:-}" ] && [ -z "${FACTORY_RELEASE_LOG_ACTIVE:-}" ]; then
  export FACTORY_RELEASE_LOG_ACTIVE=1
  _voyage_log_dir="${FACTORY_RELEASE_VOYAGE_LOG_DIR:-/var/lib/factory/release-broker}"
  _voyage_log="$_voyage_log_dir/voyage-${FACTORY_DELIVERY_ID//[^A-Za-z0-9._-]/_}.log"
  if mkdir -p -- "$_voyage_log_dir" 2>/dev/null && : >>"$_voyage_log" 2>/dev/null; then
    chmod 600 -- "$_voyage_log" 2>/dev/null || true
    exec > >(tee -a -- "$_voyage_log") 2>&1
  fi
fi

REPO="${FACTORY_RELEASE_REPO:-https://github.com/timafen/factory.git}"
SERVER_BIN="${FACTORY_SERVER_BIN:-/opt/factory-data/bin/factory-server}"
WORKER_BIN="${FACTORY_WORKER_BIN:-/opt/factory-data/bin/factory-worker}"
REL="${FACTORY_RELEASE_DIR:-/opt/factory-data/releases/factory}"
TRUSTED_GATE_PARENT="${FACTORY_RELEASE_TRUSTED_GATE_DIR:-/run/factory-release-gate}"
INFO="${FACTORY_RELEASE_INFO:-/opt/factory-data/releases/factory-current.json}"
OWNER="${FACTORY_RELEASE_OWNER-factory:factory}"
# Смена пользователя — без sudo: выпуск запускает root (в т.ч. из песочницы
# посредника с NoNewPrivileges, где sudo невозможен), а root понижается
# напрямую через setpriv. HOME рабочего пользователя задаётся явно.
if [ "${FACTORY_RELEASE_AS+x}" = x ]; then
  AS="$FACTORY_RELEASE_AS"
else
  release_user="${OWNER%%:*}"
  release_home=$(getent passwd "$release_user" | cut -d: -f6)
  AS="setpriv --reuid $release_user --regid $release_user --init-groups /usr/bin/env HOME=${release_home:-/tmp}"
fi
SERVER_SERVICE="${FACTORY_SERVER_SERVICE:-factory-server.service}"
WORKER_SERVICE="${FACTORY_WORKER_SERVICE:-factory-worker.service}"
WORKER_SERVICES="${FACTORY_WORKER_SERVICES:-}"
WORKER_UNIT_DIR="${FACTORY_WORKER_UNIT_DIR:-/etc/systemd/system}"
WORKER_CONFIG="${FACTORY_WORKER_CONFIG:-/opt/factory-data/worker.toml}"
PILOT_SERVICE="${FACTORY_PILOT_SERVICE:-factory-pilot.service}"
INTAKE_SERVICE="${FACTORY_INTAKE_SERVICE:-factory-intake.service}"
API="${FACTORY_API_URL:-http://127.0.0.1:7337}"
REGISTER_ATTEMPTS="${FACTORY_REGISTER_ATTEMPTS:-12}"
REGISTER_DELAY="${FACTORY_REGISTER_DELAY:-5}"
LOCK="${FACTORY_RELEASE_LOCK:-/run/lock/factory-release.lock}"
DATABASE="${FACTORY_DATABASE:-/opt/factory-data/server/factory.sqlite3}"
FX_BIN="${FACTORY_FX_BIN:-/usr/local/bin/fx}"
RELEASE_DRIVER="${FACTORY_RELEASE_DRIVER:-/usr/local/lib/fx-factory-release}"
BROKER_BIN="${FACTORY_RELEASE_BROKER_BIN:-/opt/factory-data/bin/factory-release-broker}"
BROKER_UNIT="${FACTORY_RELEASE_BROKER_UNIT:-/etc/systemd/system/factory-release-broker.service}"
BROKER_DROPIN="${FACTORY_RELEASE_BROKER_PILOT_DROPIN:-/etc/systemd/system/factory-pilot.service.d/50-project-release-broker.conf}"
ACCEPTANCE_BIN="${FACTORY_LIVE_ACCEPTANCE_BIN:-/usr/local/lib/factory-live-acceptance}"
BROKER_SERVICE="${FACTORY_RELEASE_BROKER_SERVICE:-factory-release-broker.service}"
BROKER_GROUP="${FACTORY_RELEASE_BROKER_GROUP:-factory-release}"
BROKER_OWNER="${FACTORY_RELEASE_BROKER_OWNER-root:root}"
CONTROL_OWNER="${FACTORY_CONTROL_OWNER-root:root}"
BRAIN_OWNER="${FACTORY_BRAIN_OWNER-factory:factory}"
BRAIN_LIVE="${FACTORY_BRAIN_LIVE:-/opt/factory-data}"
GENERATIONS="$REL/generations"
CURRENT="$REL/current"
PREVIOUS="$REL/previous"
JOURNAL="$REL/transaction"
GATE_READY_ATTEMPTS="${FACTORY_RELEASE_GATE_READY_ATTEMPTS:-500}"
GATE_STOP_ATTEMPTS="${FACTORY_RELEASE_GATE_STOP_ATTEMPTS:-100}"
GATE_POLL_DELAY="${FACTORY_RELEASE_GATE_POLL_DELAY:-0.01}"
TRUSTED_OWNER_UID=0
TRUSTED_SETSID=/usr/bin/setsid
TRUSTED_SUDO=/usr/bin/sudo
TRUSTED_BASH=/bin/bash
TRUSTED_STAT=/usr/bin/stat
TRUSTED_MKTEMP=/usr/bin/mktemp
TRUSTED_MV=/usr/bin/mv
TRUSTED_RM=/usr/bin/rm
TRUSTED_SLEEP=/bin/sleep
TRUSTED_OD=/usr/bin/od
TRUSTED_PS=/usr/bin/ps
TRUSTED_AWK=/usr/bin/awk
TRUSTED_NODE=/usr/bin/node
TRUSTED_NPX=/usr/bin/npx
TRUSTED_NPM=/usr/bin/npm
TRUSTED_GO=/usr/bin/go
TRUSTED_PYTHON=/usr/bin/python3
TRUSTED_GIT=/usr/bin/git
TRUSTED_CHMOD=/usr/bin/chmod
TRUSTED_MKDIR=/usr/bin/mkdir

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }
as_user() { if [ -n "$AS" ]; then $AS "$@"; else "$@"; fi; }
as_user_private() {
  # Как as_user, но под umask 077: дерево принадлежит рабочему пользователю
  # и закрыто для посторонних.
  if [ -n "$AS" ]; then
    $AS "$TRUSTED_BASH" -c 'umask 077; exec "$@"' factory-release-private "$@"
  else
    ( umask 077; "$@" )
  fi
}
set_owner() { if [ -n "$OWNER" ]; then chown "$OWNER" "$@"; fi; }
worker_service_list() {
  local path service
  if [ -n "$WORKER_SERVICES" ]; then
    printf '%s\n' $WORKER_SERVICES
    return
  fi
  # Internal Factory runs several model-specific workers.  They all execute
  # the same replace-in-place binary, so leaving even one service out keeps a
  # deleted old executable alive after a release.  Discover the installed
  # worker units when the caller has not supplied an explicit fixture/list.
  printf '%s\n' "$WORKER_SERVICE"
  for path in "$WORKER_UNIT_DIR"/factory-worker*.service \
              "$WORKER_UNIT_DIR"/factory-codex-*.service; do
    [ -f "$path" ] || continue
    service=${path##*/}
    [ "$service" = "$WORKER_SERVICE" ] || printf '%s\n' "$service"
  done
}
stop_workers() {
  local primary='' service
  local -a remaining=()
  while read -r service; do
    [ -n "$service" ] || continue
    if [ -z "$primary" ]; then primary=$service; else remaining+=("$service"); fi
  done < <(worker_service_list)
  [ -z "$primary" ] || systemctl stop "$primary" || return
  # systemd stops the rest in parallel.  A retained attempt anchor may need
  # the full stop timeout, but ten workers must not pay that timeout serially.
  [ "${#remaining[@]}" -eq 0 ] || systemctl stop "${remaining[@]}"
}
start_workers() {
  local service
  local -a services=()
  while read -r service; do [ -n "$service" ] && services+=("$service"); done < <(worker_service_list)
  [ "${#services[@]}" -eq 0 ] || systemctl start "${services[@]}"
}
restart_workers() {
  local service
  local -a services=()
  while read -r service; do [ -n "$service" ] && services+=("$service"); done < <(worker_service_list)
  [ "${#services[@]}" -eq 0 ] || systemctl restart "${services[@]}"
}

sync_path() {
  python3 - "$1" <<'PY'
import os,sys
fd=os.open(sys.argv[1], os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY
}

write_journal() { # phase generation previous
  local temporary="$JOURNAL.new"
  umask 077
  printf 'phase=%q\ngeneration=%q\nprevious=%q\n' "$1" "$2" "$3" >"$temporary" \
    && sync_path "$temporary" && mv -f "$temporary" "$JOURNAL" && sync_path "$REL" || return
  if [ "${FACTORY_RELEASE_CRASH_AFTER_PHASE:-}" = "$1" ]; then
    kill -KILL "$$"
  fi
}

read_journal() {
  phase= generation= previous=
  [ ! -e "$JOURNAL" ] || . "$JOURNAL"
}

manifest_hash() { sha256sum "$1/manifest.json" | awk '{print $1}'; }

verify_generation() {
  local generation=$1
  [ -d "$generation" ] && [ ! -L "$generation" ] \
    || { fail "поколение выпуска отсутствует или является ссылкой: $generation"; return 1; }
  python3 - "$generation" <<'PY'
import hashlib,json,os,stat,sys
root=sys.argv[1]
manifest_path=os.path.join(root,"manifest.json")
hash_path=os.path.join(root,"manifest.sha256")
try:
    raw=open(manifest_path,"rb").read()
    expected=open(hash_path,encoding="ascii").read().strip()
    if hashlib.sha256(raw).hexdigest()!=expected: raise ValueError("hash manifest")
    data=json.loads(raw)
    if data.get("format")!=1 or not data.get("candidate_sha"): raise ValueError("format manifest")
    for item in data.get("artifacts",[]):
        path=os.path.join(root,item["source"])
        info=os.lstat(path)
        if not stat.S_ISREG(info.st_mode): raise ValueError("not a regular file: "+path)
        body=open(path,"rb").read()
        if len(body)!=item["size"] or hashlib.sha256(body).hexdigest()!=item["sha256"]:
            raise ValueError("artifact hash: "+path)
        if stat.S_IMODE(info.st_mode)!=item["mode"]: raise ValueError("artifact mode: "+path)
    database=data.get("database",{})
    if database.get("snapshot"):
        snapshot=os.path.join(root,database["snapshot"]); marker=snapshot+".v2-control-plane"
        if stat.S_IMODE(os.lstat(snapshot).st_mode)!=0o600 or stat.S_IMODE(os.lstat(marker).st_mode)!=0o600:
            raise ValueError("snapshot mode")
        if hashlib.sha256(open(snapshot,"rb").read()).hexdigest()!=database["sha256"]:
            raise ValueError("snapshot hash")
        if hashlib.sha256(open(marker,"rb").read()).hexdigest()!=database["marker_sha256"]:
            raise ValueError("snapshot marker hash")
except Exception as exc:
    print("!! manifest поколения не прошёл проверку: %s"%exc,file=sys.stderr)
    raise SystemExit(1)
PY
}

service_state() {
  local unit=$1 active=inactive enabled=disabled
  systemctl -q is-active "$unit" 2>/dev/null && active=active || true
  systemctl -q is-enabled "$unit" 2>/dev/null && enabled=enabled || true
  printf '%s:%s' "$active" "$enabled"
}

restore_service_state() {
  local file=$1 unit state active enabled
  [ -r "$file" ] || return 1
  while IFS=$'\t' read -r unit state; do
    # This process is running under the broker cgroup.  Leave the broker
    # untouched for the whole transaction; its caller must first persist the
    # terminal outcome before systemd may recycle it.
    [ "$unit" != "$BROKER_SERVICE" ] || continue
    active=${state%%:*}; enabled=${state#*:}
    [ "$enabled" != enabled ] || systemctl enable "$unit" >/dev/null || return
    [ "$enabled" != disabled ] || systemctl disable "$unit" >/dev/null || return
    [ "$active" != active ] || systemctl start "$unit" || return
    [ "$active" != inactive ] || systemctl stop "$unit" || return
  done <"$file"
}

install_generation() {
  local generation=$1 item source target mode
  verify_generation "$generation" || return
  while IFS=$'\t' read -r source target mode owner; do
    [ -n "$source" ] || continue
    [ "$target" != - ] || continue
    mkdir -p "$(dirname "$target")" || return
    cp -f "$generation/$source" "$target.new" \
      && { [ -z "$owner" ] || chown "$owner" "$target.new"; } \
      && chmod "$mode" "$target.new" && sync_path "$target.new" && mv -f "$target.new" "$target" \
      && sync_path "$(dirname "$target")" || return
  done < <(python3 - "$generation/manifest.json" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1]))["artifacts"]:
 print("%s\t%s\t%o\t%s"%(x["source"],x["target"],x["mode"],x.get("owner","")))
PY
  )
  systemctl daemon-reload || return
}

stop_factory_units() {
  stop_workers || return
  systemctl stop "$PILOT_SERVICE" 2>/dev/null || true
  systemctl stop "$INTAKE_SERVICE" 2>/dev/null || true
  # The driver is a child of the broker service.  Stopping the broker here
  # would make systemd KillMode=control-group kill this release before it can
  # persist the terminal result.  The broker stays up until its caller exits.
  systemctl stop "$SERVER_SERVICE"
}

verify_generation_runtime() {
  local selected=$1 unit pid exe worker_id body previous_body previous_heartbeat registered attempt
  if systemctl -q is-active "$SERVER_SERVICE" 2>/dev/null; then
    pid=$(systemctl show -p MainPID --value "$SERVER_SERVICE" 2>/dev/null)
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    [ "$exe" = "$SERVER_BIN" ] \
      && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$selected/payload/factory-server" | awk '{print $1}')" ] \
      || { fail "запущенный server не совпадает с выбранным manifest"; return 1; }
    [ "$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)" = 200 ] \
      || { fail "server выбранного поколения не прошёл health"; return 1; }
  fi
  for unit in $(worker_service_list); do
    systemctl -q is-active "$unit" 2>/dev/null || continue
    pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    [ "$exe" = "$WORKER_BIN" ] \
      && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$selected/payload/factory-worker" | awk '{print $1}')" ] \
      || { fail "запущенный $unit не совпадает с выбранным manifest"; return 1; }
  done
  if systemctl -q is-active "$WORKER_SERVICE" 2>/dev/null; then
    # The identity command deliberately locks the worker data directory. It
    # cannot run beside the live worker that owns that lock, so a recovery
    # verification must obtain the identity while the primary worker is
    # stopped and then prove that the restarted process registered freshly.
    systemctl stop "$WORKER_SERVICE" || return
    worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>/dev/null) \
      || { systemctl start "$WORKER_SERVICE" >/dev/null 2>&1 || true; return 1; }
    previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
    previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("last_heartbeat", ""))
except Exception: print("")' 2>/dev/null || true)
    systemctl start "$WORKER_SERVICE" || return
    registered=0
    for ((attempt=1; attempt<=REGISTER_ATTEMPTS; attempt++)); do
      body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
      if printf '%s' "$body" | python3 -c 'import datetime,json,sys
try:
 w=json.load(sys.stdin); h=w.get("last_heartbeat", ""); old=sys.argv[2]
 parsed=datetime.datetime.fromisoformat(h.replace("Z","+00:00")); now=datetime.datetime.now(datetime.timezone.utc)
 ok=w.get("id")==sys.argv[1] and w.get("health")=="healthy" and w.get("online") is True and h and (not old or h>old) and 0 <= (now-parsed).total_seconds() <= 120
except Exception: ok=False
raise SystemExit(not ok)' "$worker_id" "$previous_heartbeat"; then registered=1; break; fi
      sleep "$REGISTER_DELAY"
    done
    [ "$registered" = 1 ] \
      || { fail "worker выбранного поколения не зарегистрировался свежим и healthy"; return 1; }
  fi
}

database_ledger() {
  python3 - "$1" <<'PY'
import sqlite3,sys
db=sqlite3.connect("file:"+sys.argv[1]+"?mode=ro",uri=True)
values=[x[0] for x in db.execute("select version from schema_migrations order by version")]
if values!=list(range(1,len(values)+1)): raise SystemExit("ledger миграций имеет разрыв")
print(values[-1] if values else 0)
PY
}

rollback_to_generation() { # generation, owner-facing reason
  local target=$1 reason=$2 live_ledger generation_ledger
  fail "$reason — возвращаю полный прежний комплект"
  stop_factory_units || true
  install_generation "$target" || { fail "полный комплект не восстановлен; journal оставлен: $JOURNAL"; return 1; }
  cp -f "$target/release-info.json" "$INFO.new" && set_owner "$INFO.new" && chmod 600 "$INFO.new" \
    && sync_path "$INFO.new" && mv -f "$INFO.new" "$INFO" && sync_path "$(dirname "$INFO")" || return
  live_ledger=$(database_ledger "$DATABASE") || return
  generation_ledger=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("database",{}).get("ledger",-1))' "$target/manifest.json")
  if [ "$generation_ledger" -ge 0 ] && [ "$live_ledger" -gt "$generation_ledger" ]; then
    [ -z "${previous:-}" ] || { ln -sfn "$previous" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"; }
    ln -sfn "$target" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
    write_journal db_restore_required "$target" "${previous:-}"
    fail "код возвращён, но база новее ($live_ledger > $generation_ledger); службы остановлены. Выполните отдельный fx factory restore-db"
    return 9
  fi
  restore_service_state "$target/services.tsv" || return
  verify_generation_runtime "$target" || { fail "проверка полного отката не завершена; journal оставлен"; return 1; }
  ln -sfn "$target" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
  if [ ! -e "$PREVIOUS" ] && [ ! -L "$PREVIOUS" ]; then
    ln -sfn "$target" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS" || return
  fi
  rm -f "$JOURNAL"
  sync_path "$REL"
}
case "$GATE_READY_ATTEMPTS:$GATE_STOP_ATTEMPTS" in
  *[!0-9:]*|:*|*:) fail "некорректный лимит ожидания test gate"; exit 4 ;;
esac

validate_trusted_executable() { # validate_trusted_executable <absolute path>
  local executable=$1 owner mode
  case "$executable" in /*) ;; *) return 1 ;; esac
  [ -f "$executable" ] && [ -x "$executable" ] || return 1
  owner=$("$TRUSTED_STAT" -Lc %u -- "$executable" 2>/dev/null) || return 1
  mode=$("$TRUSTED_STAT" -Lc %a -- "$executable" 2>/dev/null) || return 1
  [ "$owner" = "$TRUSTED_OWNER_UID" ] || return 1
  (( (8#$mode & 0022) == 0 ))
}

for trusted_executable in "$TRUSTED_STAT" "$TRUSTED_SETSID" "$TRUSTED_SUDO" \
  "$TRUSTED_BASH" "$TRUSTED_MKTEMP" "$TRUSTED_MV" "$TRUSTED_RM" \
  "$TRUSTED_SLEEP" "$TRUSTED_OD" "$TRUSTED_PS" "$TRUSTED_AWK" "$TRUSTED_NODE" \
  "$TRUSTED_NPX" "$TRUSTED_NPM" "$TRUSTED_GO" "$TRUSTED_GIT" "$TRUSTED_CHMOD" \
  "$TRUSTED_MKDIR"; do
  validate_trusted_executable "$trusted_executable" \
    || { fail "нет доверенного executable для test gate: $trusted_executable"; exit 4; }
done

# $AS is intentionally not accepted here. It is a convenience wrapper for
# workspace operations and may be supplied by the caller, so it cannot be in
# the trust chain that reports a gate result. The gate identity instead comes
# from OWNER and is entered through one fixed, root-owned launcher whose wait
# status is authoritative. OWNER='' is the explicit no-switch mode used by the
# hermetic test fixture (and by an operator already running as the target UID).
gate_identity=()
if [ -n "$OWNER" ]; then
  gate_user=${OWNER%%:*}
  if ! [[ "$gate_user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    fail "некорректный пользователь для test gate"
    exit 4
  fi
  gate_identity=("$TRUSTED_SUDO" -H -u "$gate_user" --)
fi

preflight_fail() {
  fail "выпуск остановлен: $1; живую metadata не исправляли автоматически — для выпуска нужна проверенная восстановимая исходная точка"
}

path_is_present() { [ -e "$1" ] || [ -L "$1" ]; }

validate_release_history() {
  local current_present=0 previous_present=0 first_generation='' candidate generations_real
  bootstrap_release=0
  current_generation=''
  previous_generation=''

  if path_is_present "$REL"; then
    [ -d "$REL" ] && [ ! -L "$REL" ] \
      || { preflight_fail "каталог выпусков повр…8254 tokens truncated…fail "одна из полных проверок не прошла — релиз не поеду"; cleanup; exit 5; }
else
  step "быстрый выпуск: код уже проверен обязательным Linux-воротом GitHub"
fi
step "собираю интерфейс"
as_user bash -c "cd '$work/src/web' && npx vite build" \
  || { fail "сборка интерфейса не прошла"; cleanup; exit 5; }
step "собираю сервер и воркер"
build_ldflags="-X github.com/owainlewis/factory/internal/buildinfo.Version=candidate -X github.com/owainlewis/factory/internal/buildinfo.Commit=$sha"
as_user bash -c "cd '$work/src' && go build -ldflags '$build_ldflags' -o '$work/factory-server' ./cmd/factory-server" \
  && as_user bash -c "cd '$work/src' && go build -ldflags '$build_ldflags' -o '$work/factory-worker' ./cmd/factory-worker" \
  && as_user bash -c "cd '$work/src' && go build -ldflags '$build_ldflags' -o '$work/factory-release-broker' ./cmd/factory-release-broker" \
  || { fail "сборка сервера, воркера или release-broker не прошла"; cleanup; exit 5; }

step "проверяю собранные server и worker до первой мутации"
candidate_server_version=$("$work/factory-server" version 2>/dev/null || true)
candidate_worker_version=$("$work/factory-worker" version 2>/dev/null || true)
[[ "$candidate_server_version" == *"$sha"* && "$candidate_worker_version" == *"$sha"* ]] \
  || { fail "собранные server/worker не подтверждают candidate SHA $sha"; cleanup; exit 4; }

processes="$work/processes.tsv"
: >"$processes"
for unit in "$SERVER_SERVICE" $(worker_service_list) "$PILOT_SERVICE" "$INTAKE_SERVICE" "$BROKER_SERVICE"; do
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  case "$pid" in ''|0|*[!0-9]*) fail "у активной службы $unit нет MainPID"; cleanup; exit 4 ;; esac
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || { fail "не найден executable MainPID $pid ($unit)"; cleanup; exit 4; }
  case "$exe" in *' (deleted)') fail "процесс $unit использует deleted-inode"; cleanup; exit 4 ;; esac
  [ -f "$exe" ] || { fail "неизвестный executable $exe у $unit"; cleanup; exit 4; }
  exec_start=$(systemctl show -p ExecStart --value "$unit" 2>/dev/null)
  [ -n "$exec_start" ] && [[ "$exec_start" == *"$exe"* || "$unit" = "$PILOT_SERVICE" || "$unit" = "$INTAKE_SERVICE" ]] \
    || { fail "MainPID и ExecStart расходятся у $unit"; cleanup; exit 4; }
  printf '%s\t%s\t%s\t%s\n' "$unit" "$pid" "$exe" "$(sha256sum "$exe" | awk '{print $1}')" >>"$processes"
done

required_bytes=$(du -cb "$DATABASE" "$SERVER_BIN" "$WORKER_BIN" "$work/factory-server" "$work/factory-worker" 2>/dev/null | tail -1 | awk '{print int($1*2.25)}')
available_bytes=$(df -Pk "$REL" | awk 'NR==2 {print $4*1024}')
available_inodes=$(df -Pi "$REL" | awk 'NR==2 {print $4}')
[ "$available_bytes" -ge "$required_bytes" ] && [ "$available_inodes" -ge 32 ] \
  || { fail "недостаточно свободного места или inode для snapshot и двух комплектов"; cleanup; exit 4; }

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${sha:0:12}-$$"
stage="$REL/.generation-$release_id.$$"
generation_path="$GENERATIONS/$release_id"
mkdir -m 700 "$stage" "$stage/payload" || { cleanup; exit 4; }
inventory="$stage/inventory.tsv"
: >"$inventory"
printf '[Service]\nSupplementaryGroups=%s\n' "$BROKER_GROUP" >"$work/factory-release-broker-dropin.conf"
add_artifact() { # source payload-name target mode owner
  local source=$1 name=$2 target=$3 mode=$4 owner=$5 destination
  destination="$stage/payload/$name"
  cp -f "$source" "$destination" && chmod "$mode" "$destination" || return
  printf 'payload/%s\t%s\t%s\t%s\n' "$name" "$target" "$mode" "$owner" >>"$inventory"
}
add_artifact "$work/factory-server" factory-server "$SERVER_BIN" 755 "$OWNER" \
  && add_artifact "$work/factory-worker" factory-worker "$WORKER_BIN" 755 "$OWNER" \
  && add_artifact "$work/factory-release-broker" factory-release-broker "$BROKER_BIN" 755 "$BROKER_OWNER" \
  && add_artifact "$work/src/ops/systemd/factory-release-broker.service" factory-release-broker.service "$BROKER_UNIT" 644 "$BROKER_OWNER" \
  && add_artifact "$work/factory-release-broker-dropin.conf" factory-release-broker-dropin.conf "$BROKER_DROPIN" 644 "$BROKER_OWNER" \
  && add_artifact "$work/src/ops/factory-live-acceptance" factory-live-acceptance "$ACCEPTANCE_BIN" 755 "$BROKER_OWNER" \
  && add_artifact "$work/src/ops/fx" fx "$FX_BIN" 755 "$CONTROL_OWNER" \
  && add_artifact "$work/src/ops/fx-factory-release" fx-factory-release "$RELEASE_DRIVER" 755 "$CONTROL_OWNER" \
  && add_artifact "$work/src/pilot/pilot.py" pilot.py "$BRAIN_LIVE/pilot/pilot.py" 644 "$BRAIN_OWNER" \
  && add_artifact "$work/src/pilot/context.md" context.md "$BRAIN_LIVE/pilot/context.md" 644 "$BRAIN_OWNER" \
  && add_artifact "$work/src/intake/app.py" intake-app.py "$BRAIN_LIVE/intake/app.py" 644 "$BRAIN_OWNER" \
  && add_artifact "$work/src/intake/plan.py" intake-plan.py "$BRAIN_LIVE/intake/plan.py" 644 "$BRAIN_OWNER" \
  || { fail "не удалось собрать полный кандидатный комплект"; cleanup; exit 4; }

services="$stage/services.tsv"
for unit in "$SERVER_SERVICE" $(worker_service_list) "$PILOT_SERVICE" "$INTAKE_SERVICE" "$BROKER_SERVICE"; do
  printf '%s\t%s\n' "$unit" "$(service_state "$unit")" >>"$services"
done
chmod 600 "$services"
printf 'services.tsv\t-\t600\t\n' >>"$inventory"

step "создаю и повторно проверяю SQLite online snapshot"
snapshot="$stage/database.sqlite3"
# Снимок делает рабочий пользователь: сервер требует, чтобы снимал хозяин базы
# (root им не является). Пишет в свою папку сборки, готовое перекладывает root.
snapshot_build="$work/database.sqlite3"
as_user "$SERVER_BIN" -database "$DATABASE" -backup "$snapshot_build" \
  || {
    fail "текущий server не знает новую схему — создаю snapshot свежесобранным server"
    as_user rm -f -- "$snapshot_build" "$snapshot_build-wal" "$snapshot_build-shm" "$snapshot_build.v2-control-plane"
    as_user "$work/factory-server" -database "$DATABASE" -backup "$snapshot_build" \
      || { fail "собранный server также не смог создать проверенный snapshot"; cleanup; exit 4; }
  }
[ -f "$snapshot_build" ] && [ ! -e "$snapshot_build-wal" ] && [ ! -e "$snapshot_build-shm" ] \
  || { fail "snapshot не является standalone SQLite"; cleanup; exit 4; }
mv -- "$snapshot_build" "$snapshot" \
  && mv -- "$snapshot_build.v2-control-plane" "$snapshot.v2-control-plane" \
  || { fail "не смог переложить snapshot в поколение"; cleanup; exit 4; }
chmod 600 "$snapshot" "$snapshot.v2-control-plane"
ledger=$(database_ledger "$snapshot") || { cleanup; exit 4; }
schema_digest=$(python3 - "$snapshot" <<'PY'
import hashlib,sqlite3,sys
d=sqlite3.connect("file:"+sys.argv[1]+"?mode=ro",uri=True)
rows=d.execute("select type,name,tbl_name,coalesce(sql,'') from sqlite_schema order by type,name").fetchall()
print(hashlib.sha256(repr(rows).encode()).hexdigest())
PY
)

python3 - "$stage/release-info.json" "$sha" "$subject" "$ref" "$release_id" <<'PY'
import datetime,json,sys
p,sha,subject,ref,rid=sys.argv[1:]
at=datetime.datetime.now(datetime.timezone.utc).isoformat()
json.dump({"name":"согласованный выпуск: "+subject,"sha":sha,"short":sha[:7],"ref":ref,
 "subject":subject,"at":at,"release_id":rid},open(p,"w"),ensure_ascii=False,sort_keys=True,separators=(",",":"))
PY
chmod 600 "$stage/release-info.json"
printf 'release-info.json\t-\t600\t\n' >>"$inventory"

python3 - "$stage" "$release_id" "$sha" "$ref" "$DATABASE" "$snapshot" "$ledger" "$schema_digest" "$inventory" "$processes" "$services" <<'PY'
import hashlib,json,os,stat,sys
root,rid,sha,ref,db,snapshot,ledger,schema,inventory,processes,services=sys.argv[1:]
items=[]
for line in open(inventory):
 source,target,mode,owner=line.rstrip("\n").split("\t"); path=os.path.join(root,source); body=open(path,"rb").read()
 items.append({"source":source,"target":target,"mode":int(mode,8),"owner":owner,"size":len(body),"sha256":hashlib.sha256(body).hexdigest()})
proc=[]
for line in open(processes):
 unit,pid,exe,digest=line.rstrip("\n").split("\t"); proc.append({"unit":unit,"pid":int(pid),"exe":exe,"sha256":digest})
service_states=[]
for line in open(services):
 unit,state=line.rstrip("\n").split("\t"); service_states.append({"unit":unit,"state":state})
body=open(snapshot,"rb").read()
marker=open(snapshot+".v2-control-plane","rb").read()
data={"format":1,"release_id":rid,"candidate_sha":sha,"ref":ref,"artifacts":items,"processes":proc,"services":service_states,
 "database":{"live_path":db,"snapshot":"database.sqlite3","sha256":hashlib.sha256(body).hexdigest(),"size":len(body),"marker_sha256":hashlib.sha256(marker).hexdigest(),"ledger":int(ledger),"schema_digest":schema}}
raw=(json.dumps(data,ensure_ascii=False,sort_keys=True,separators=(",",":"))+"\n").encode()
open(os.path.join(root,"manifest.json"),"wb").write(raw)
open(os.path.join(root,"manifest.sha256"),"w").write(hashlib.sha256(raw).hexdigest()+"\n")
PY
chmod 600 "$stage/manifest.json" "$stage/manifest.sha256" "$stage/services.tsv"
sync_path "$snapshot" && sync_path "$snapshot.v2-control-plane" && sync_path "$stage/manifest.json" \
  && sync_path "$stage" || { cleanup; exit 4; }
verify_generation "$stage" || { cleanup; exit 4; }

old_generation=''
if [ "$bootstrap_release" = 1 ]; then
  bootstrap="$REL/.bootstrap-${current_sha:0:12}.$$"
  mkdir -m 700 "$bootstrap" "$bootstrap/payload"
  old_inventory="$bootstrap/inventory.tsv"; : >"$old_inventory"
  old_add() { local source=$1 name=$2 target=$3 mode=$4 owner=$5; cp -f "$source" "$bootstrap/payload/$name" && chmod "$mode" "$bootstrap/payload/$name" && printf 'payload/%s\t%s\t%s\t%s\n' "$name" "$target" "$mode" "$owner" >>"$old_inventory"; }
  old_add "$SERVER_BIN" factory-server "$SERVER_BIN" 755 "$OWNER" && old_add "$WORKER_BIN" factory-worker "$WORKER_BIN" 755 "$OWNER" \
    && old_add "$BROKER_BIN" factory-release-broker "$BROKER_BIN" 755 "$BROKER_OWNER" \
    && old_add "$BROKER_UNIT" factory-release-broker.service "$BROKER_UNIT" 644 "$BROKER_OWNER" \
    && old_add "$BROKER_DROPIN" factory-release-broker-dropin.conf "$BROKER_DROPIN" 644 "$BROKER_OWNER" \
    && old_add "$ACCEPTANCE_BIN" factory-live-acceptance "$ACCEPTANCE_BIN" 755 "$BROKER_OWNER" \
    && old_add "$FX_BIN" fx "$FX_BIN" 755 "$CONTROL_OWNER" \
    && old_add "$RELEASE_DRIVER" fx-factory-release "$RELEASE_DRIVER" 755 "$CONTROL_OWNER" \
    && old_add "$BRAIN_LIVE/pilot/pilot.py" pilot.py "$BRAIN_LIVE/pilot/pilot.py" 644 "$BRAIN_OWNER" \
    && old_add "$BRAIN_LIVE/pilot/context.md" context.md "$BRAIN_LIVE/pilot/context.md" 644 "$BRAIN_OWNER" \
    && old_add "$BRAIN_LIVE/intake/app.py" intake-app.py "$BRAIN_LIVE/intake/app.py" 644 "$BRAIN_OWNER" \
    && old_add "$BRAIN_LIVE/intake/plan.py" intake-plan.py "$BRAIN_LIVE/intake/plan.py" 644 "$BRAIN_OWNER" || { cleanup; exit 4; }
  cp -f "$INFO" "$bootstrap/release-info.json" && chmod 600 "$bootstrap/release-info.json" \
    && cp -f "$services" "$bootstrap/services.tsv" && chmod 600 "$bootstrap/services.tsv" \
    && cp -f "$snapshot" "$bootstrap/database.sqlite3" \
    && cp -f "$snapshot.v2-control-plane" "$bootstrap/database.sqlite3.v2-control-plane" \
    && chmod 600 "$bootstrap/database.sqlite3" "$bootstrap/database.sqlite3.v2-control-plane" \
    || { fail "не удалось собрать полный bootstrap-комплект"; cleanup; exit 4; }
  printf 'release-info.json\t-\t600\t\n' >>"$old_inventory"
  printf 'services.tsv\t-\t600\t\n' >>"$old_inventory"
  python3 - "$bootstrap" "$current_sha" "$current_release_id" "$old_inventory" "$processes" "$services" "$DATABASE" "$bootstrap/database.sqlite3" "$ledger" "$schema_digest" <<'PY'
import hashlib,json,os,sys
root,sha,source_release_id,inventory,processes,services,db,snapshot,ledger,schema=sys.argv[1:]; items=[]
for line in open(inventory):
 s,t,m,o=line.rstrip("\n").split("\t"); b=open(os.path.join(root,s),"rb").read(); items.append({"source":s,"target":t,"mode":int(m,8),"owner":o,"size":len(b),"sha256":hashlib.sha256(b).hexdigest()})
proc=[]
for line in open(processes):
 u,p,e,h=line.rstrip("\n").split("\t"); proc.append({"unit":u,"pid":int(p),"exe":e,"sha256":h})
states=[]
for line in open(services):
 u,s=line.rstrip("\n").split("\t"); states.append({"unit":u,"state":s})
digest=open(snapshot,"rb").read(); marker=open(snapshot+".v2-control-plane","rb").read()
d={"format":1,"release_id":"bootstrap-"+sha[:12],"source_release_id":source_release_id,"candidate_sha":sha,"ref":"installed","artifacts":items,"processes":proc,"services":states,"database":{"live_path":db,"snapshot":"database.sqlite3","sha256":hashlib.sha256(digest).hexdigest(),"size":len(digest),"marker_sha256":hashlib.sha256(marker).hexdigest(),"ledger":int(ledger),"schema_digest":schema}}
r=(json.dumps(d,sort_keys=True,separators=(",",":"))+"\n").encode(); open(root+"/manifest.json","wb").write(r); open(root+"/manifest.sha256","w").write(hashlib.sha256(r).hexdigest()+"\n")
PY
  chmod 600 "$bootstrap/manifest.json" "$bootstrap/manifest.sha256" "$bootstrap/services.tsv"
  sync_path "$bootstrap/database.sqlite3" && sync_path "$bootstrap/database.sqlite3.v2-control-plane" \
    && sync_path "$bootstrap/manifest.json" && sync_path "$bootstrap" \
    || { cleanup; exit 4; }
  verify_generation "$bootstrap" || { cleanup; exit 4; }
  old_generation="$GENERATIONS/bootstrap-${current_sha:0:12}"
  mv "$bootstrap" "$old_generation" && sync_path "$GENERATIONS"
  bootstrap=''
else
  old_generation=$current_generation
  verify_generation "$old_generation" || { cleanup; exit 4; }
fi

mv "$stage" "$generation_path" && sync_path "$GENERATIONS" || { cleanup; exit 4; }
verify_generation "$generation_path" || { cleanup; exit 4; }
write_journal prepared "$generation_path" "$old_generation" || { cleanup; exit 4; }
previous=$old_generation
rollback_armed=1
rollback() { local why=$1 status=$2; trap - EXIT HUP INT TERM; rollback_armed=0; rollback_to_generation "$old_generation" "$why"; result=$?; cleanup; [ "$result" -eq 0 ] || status=$result; exit "$status"; }
on_exit() { status=$?; [ "$rollback_armed" = 1 ] || return; [ "$status" -ne 0 ] || status=130; rollback "выпуск прерван" "$status"; }
trap on_exit EXIT; trap 'rollback "сигнал HUP" 130' HUP; trap 'rollback "сигнал INT" 130' INT; trap 'rollback "сигнал TERM" 130' TERM

step "останавливаю прежний комплект и атомарно ставлю согласованную пару"
stop_factory_units || rollback "службы не остановились" 6
write_journal old-stopped "$generation_path" "$old_generation" || rollback "journal не записан" 4
install_generation "$generation_path" || rollback "полный комплект не установлен" 4
write_journal pair-installed "$generation_path" "$old_generation" || rollback "journal не записан" 4
systemctl start "$SERVER_SERVICE" || rollback "сервер не стартовал" 6
sleep 5
code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)
[ "$code" = 200 ] || rollback "health нового сервера: HTTP $code" 6
worker_id=''
for identity_attempt in 1 2 3 4 5; do
  worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>/dev/null) && [ -n "$worker_id" ] && break
  worker_id=''; sleep 1
done
[ -n "$worker_id" ] || rollback "не определена identity воркера" 6
previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("last_heartbeat",""))' 2>/dev/null || true)
start_workers || rollback "воркеры не стартовали" 6
registered=0
for ((attempt=1; attempt<=REGISTER_ATTEMPTS; attempt++)); do
  body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
  if printf '%s' "$body" | python3 -c 'import datetime,json,sys
try:
 w=json.load(sys.stdin); h=w.get("last_heartbeat",""); old=sys.argv[2]
 ok=w.get("id")==sys.argv[1] and w.get("health")=="healthy" and w.get("online") is True and h and (not old or h>old)
except Exception: ok=False
raise SystemExit(not ok)' "$worker_id" "$previous_heartbeat" 2>/dev/null; then registered=1; break; fi
  sleep "$REGISTER_DELAY"
done
[ "$registered" = 1 ] || rollback "нет свежей healthy-регистрации воркера $worker_id" 6
for pair in "$SERVER_SERVICE:$SERVER_BIN:$generation_path/payload/factory-server"; do
  unit=${pair%%:*}; rest=${pair#*:}; installed=${rest%%:*}; expected=${rest#*:}
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
  [ "$exe" = "$installed" ] && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$expected" | awk '{print $1}')" ] \
    || rollback "реально запущенный $unit не совпадает с manifest" 6
done
for unit in $(worker_service_list); do
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
  [ "$exe" = "$WORKER_BIN" ] && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$generation_path/payload/factory-worker" | awk '{print $1}')" ] \
    || rollback "реально запущенный $unit не совпадает с manifest" 6
done
restore_service_state "$generation_path/services.tsv" || rollback "состояния служб не восстановлены" 6
write_journal services-started "$generation_path" "$old_generation" || rollback "journal не записан" 4

cp -f "$generation_path/release-info.json" "$INFO.new" && set_owner "$INFO.new" && chmod 600 "$INFO.new" \
  && sync_path "$INFO.new" && mv -f "$INFO.new" "$INFO" && sync_path "$(dirname "$INFO")" \
  || rollback "правдивые metadata не опубликованы" 7
ln -sfn "$old_generation" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"
ln -sfn "$generation_path" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
write_journal committed "$generation_path" "$old_generation" || rollback "commit journal не записан" 7
rollback_armed=0
rm -f "$JOURNAL"; sync_path "$REL"
cleanup

# Retention runs only after commit and always protects current, previous and the
# bootstrap snapshots from ledger 27 or earlier. Every other generation is
# unreachable by the rollback command, so retaining and re-hashing it only
# consumes disk and lengthens every later release.
current_real=$(readlink -f "$CURRENT"); previous_real=$(readlink -f "$PREVIOUS")
while read -r candidate; do
  [ "$candidate" != "$current_real" ] || continue
  [ "$candidate" != "$previous_real" ] || continue
  candidate_ledger=$(python3 - "$candidate/manifest.json" <<'PY' 2>/dev/null || echo 999999
import json, sys
print(int(json.load(open(sys.argv[1])).get("database", {}).get("ledger", 999999)))
PY
)
  if [ "$candidate_ledger" -le 27 ]; then
    continue
  fi
  rm -rf -- "$candidate"
  echo "== retention: удалено старое поколение вне current/previous: $(basename "$candidate")"
done < <(find "$GENERATIONS" -mindepth 1 -maxdepth 1 -type d -print)
sync_path "$GENERATIONS"
echo "== выкачено: $subject; current=$sha previous=$current_sha snapshot=$(basename "$generation_path")/database.sqlite3 manifest=$(manifest_hash "$generation_path")"
exit 0

