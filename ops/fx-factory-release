#!/bin/bash
# Собирает Фабрику из git и выкатывает сервер и воркер одной ревизией.
set -uo pipefail

ref="${1:-main}"
REPO="${FACTORY_RELEASE_REPO:-https://github.com/timafen/factory.git}"
SERVER_BIN="${FACTORY_SERVER_BIN:-/opt/factory-data/bin/factory-server}"
WORKER_BIN="${FACTORY_WORKER_BIN:-/opt/factory-data/bin/factory-worker}"
REL="${FACTORY_RELEASE_DIR:-/opt/factory-data/releases/factory}"
INFO="${FACTORY_RELEASE_INFO:-/opt/factory-data/releases/factory-current.json}"
AS="${FACTORY_RELEASE_AS-sudo -H -u factory}"
OWNER="${FACTORY_RELEASE_OWNER-factory:factory}"
SERVER_SERVICE="${FACTORY_SERVER_SERVICE:-factory-server.service}"
WORKER_SERVICE="${FACTORY_WORKER_SERVICE:-factory-worker.service}"
WORKER_CONFIG="${FACTORY_WORKER_CONFIG:-/opt/factory-data/worker.toml}"
API="${FACTORY_API_URL:-http://127.0.0.1:7337}"
REGISTER_ATTEMPTS="${FACTORY_REGISTER_ATTEMPTS:-12}"
REGISTER_DELAY="${FACTORY_REGISTER_DELAY:-5}"

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }
as_user() { if [ -n "$AS" ]; then $AS "$@"; else "$@"; fi; }
set_owner() { if [ -n "$OWNER" ]; then chown "$OWNER" "$@"; fi; }

mkdir -p "$REL" && set_owner "$REL" || { fail "не смог подготовить папку релизов"; exit 4; }
mkdir -p "$(dirname "$INFO")" && set_owner "$(dirname "$INFO")" \
  || { fail "не смог подготовить release-info"; exit 4; }
work=$(as_user mktemp -d "$REL/build-XXXXXX") \
  || { fail "не смог создать папку сборки"; exit 4; }
cleanup() { rm -rf "$work"; }

step "беру исходники: $ref"
as_user git clone --quiet "$REPO" "$work/src" \
  || { fail "не смог забрать репозиторий с GitHub"; cleanup; exit 4; }
as_user git -C "$work/src" checkout --quiet -B fx-build "origin/$ref" 2>/dev/null \
  || as_user git -C "$work/src" checkout --quiet "$ref" 2>/dev/null \
  || { fail "нет такой точки сборки: $ref"; cleanup; exit 4; }
sha=$(as_user git -C "$work/src" rev-parse HEAD)
subject=$(as_user git -C "$work/src" log -1 --pretty=%s)
step "собираю ${sha:0:7} — $subject"

step "ставлю зависимости интерфейса"
as_user bash -c "cd '$work/src/web' && npm ci --no-audit --no-fund --silent" \
  || { fail "npm ci не прошёл"; cleanup; exit 4; }
step "проверяю типы интерфейса"
as_user bash -c "cd '$work/src/web' && npx tsc -p tsconfig.app.json --noEmit" \
  || { fail "в интерфейсе есть ошибки типов — релиз не поеду"; cleanup; exit 5; }
step "гоняю тесты интерфейса"
as_user bash -c "cd '$work/src/web' && npm test" \
  || { fail "тесты интерфейса не прошли — релиз не поеду"; cleanup; exit 5; }
step "гоняю тесты Go"
as_user bash -c "cd '$work/src' && go test ./..." \
  || { fail "тесты Go не прошли — релиз не поеду"; cleanup; exit 5; }
step "проверяю сценарий выката и отката"
as_user bash -c "cd '$work/src' && bash ops/test-fx-factory-release.sh" \
  || { fail "проверка выката и отката не прошла — релиз не поеду"; cleanup; exit 5; }
step "собираю интерфейс"
as_user bash -c "cd '$work/src/web' && npx vite build" \
  || { fail "сборка интерфейса не прошла"; cleanup; exit 5; }
step "собираю сервер и воркер"
as_user bash -c "cd '$work/src' && go build -o '$work/factory-server' ./cmd/factory-server" \
  && as_user bash -c "cd '$work/src' && go build -o '$work/factory-worker' ./cmd/factory-worker" \
  || { fail "сборка сервера или воркера не прошла"; cleanup; exit 5; }

step "сохраняю работающую пару бинарей"
cp -f "$SERVER_BIN" "$work/factory-server.prev" \
  && cp -f "$WORKER_BIN" "$work/factory-worker.prev" \
  || { fail "не смог сохранить текущие сервер и воркер"; cleanup; exit 4; }

rollback() {
  trap - EXIT HUP INT TERM
  rollback_armed=0
  fail "$1 — возвращаю предыдущие сервер и воркер"
  cp -f "$work/factory-server.prev" "$SERVER_BIN.new" \
    && mv -f "$SERVER_BIN.new" "$SERVER_BIN"
  cp -f "$work/factory-worker.prev" "$WORKER_BIN.new" \
    && mv -f "$WORKER_BIN.new" "$WORKER_BIN"
  systemctl restart "$SERVER_SERVICE" || true
  systemctl restart "$WORKER_SERVICE" || true
  cleanup
  exit "$2"
}

rollback_armed=1
on_exit() {
  status=$?
  [ "$rollback_armed" = 1 ] || return
  [ "$status" -ne 0 ] || status=130
  rollback "выпуск прерван до подтверждения новой пары" "$status"
}
on_signal() { rollback "выпуск прерван сигналом $1" 130; }
trap on_exit EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

install_binary() {
  source=$1 target=$2
  cp -f "$source" "$target.new" && set_owner "$target.new" \
    && chmod 755 "$target.new" && mv -f "$target.new" "$target"
}

step "ставлю новую пару и перезапускаю сервер"
install_binary "$work/factory-server" "$SERVER_BIN" || rollback "не смог поставить сервер" 4
install_binary "$work/factory-worker" "$WORKER_BIN" || rollback "не смог поставить воркер" 4
systemctl restart "$SERVER_SERVICE" || rollback "сервер не перезапустился" 6
sleep 5

code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)
[ "$code" = "200" ] || rollback "после перезапуска Фабрика отвечает $code" 6

worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>/dev/null) \
  || rollback "не удалось определить identity воркера" 6
[ -n "$worker_id" ] || rollback "identity воркера пуст" 6
systemctl stop "$WORKER_SERVICE" || rollback "воркер не остановился" 6
previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c \
  'import json,sys
try: print(json.load(sys.stdin).get("last_heartbeat", ""))
except Exception: print("")' 2>/dev/null)
systemctl start "$WORKER_SERVICE" || rollback "воркер не запустился" 6

step "жду здоровую регистрацию воркера $worker_id"
registered=0
attempt=1
while [ "$attempt" -le "$REGISTER_ATTEMPTS" ]; do
  body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
  if printf '%s' "$body" | python3 -c \
    'import datetime,json,sys
try:
 w=json.load(sys.stdin); current=w.get("last_heartbeat", "")
 fresh=bool(current) and (not sys.argv[2] or datetime.datetime.fromisoformat(current.replace("Z", "+00:00")) > datetime.datetime.fromisoformat(sys.argv[2].replace("Z", "+00:00")))
 ok=w.get("id") == sys.argv[1] and w.get("health") == "healthy" and w.get("online") is True and fresh
except Exception: ok=False
raise SystemExit(not ok)' \
    "$worker_id" "$previous_heartbeat" 2>/dev/null; then
    registered=1
    break
  fi
  attempt=$((attempt + 1))
  [ "$attempt" -gt "$REGISTER_ATTEMPTS" ] || sleep "$REGISTER_DELAY"
done
[ "$registered" = 1 ] || rollback "воркер $worker_id не зарегистрировался здоровым" 6

if [ -x "$work/src/ops/install-brain.sh" ]; then
  bash "$work/src/ops/install-brain.sh" "$work/src" \
    || fail "мозг не встал — сервер и воркер уже обновлены"
fi

python3 - "$INFO" "$sha" "$subject" "$ref" "$(date -Is)" <<'PY'
import json, sys, datetime
p, sha, subj, ref, iso = sys.argv[1:6]
M = ["января","февраля","марта","апреля","мая","июня",
     "июля","августа","сентября","октября","ноября","декабря"]
d = datetime.datetime.fromisoformat(iso)
when = "%d %s, %02d:%02d" % (d.day, M[d.month - 1], d.hour, d.minute)
json.dump({"name": "релиз от %s, из %s: %s" % (when, ref, subj),
           "sha": sha, "short": sha[:7], "ref": ref,
           "subject": subj, "when": when, "at": iso},
          open(p, "w"), ensure_ascii=False, indent=2)
print("== выкачено: релиз от %s, из %s: %s (%s)" % (when, ref, subj, sha[:7]))
PY
set_owner "$INFO" 2>/dev/null || true

rollback_armed=0
cleanup
ls -1dt "$REL"/build-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
exit 0
