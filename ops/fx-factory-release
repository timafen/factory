 source,target,mode,owner=line.rstrip("\n").split("\t"); path=os.path.join(root,source); body=open(path,"rb").read()
 items.append({"source":source,"target":target,"mode":int(mode,8),"owner":owner,"size":len(body),"sha256":hashlib.sha256(body).hexdigest()})
