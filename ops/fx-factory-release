  || ! "$TRUSTED_CHMOD" 555 "$trusted_gate_script" "$trusted_gate_root/ops/fx-factory-release" \
  || [ "$("$TRUSTED_GIT" hash-object "$trusted_gate_script")" != "$expected_gate_blob" ] \
  || [ "$("$TRUSTED_GIT" hash-object "$trusted_gate_root/ops/fx-factory-release")" != "$expected_gate_release_blob" ]; then
  fail "gate script не совпадает с криптографически проверенным Git-объектом"
  cleanup
  exit 4
fi
trusted_systemd_files=0
while IFS= read -r -d '' trusted_gate_path; do
  case "$trusted_gate_path" in ops/systemd/*) ;; *) fail "некорректный путь доверенного systemd tree"; cleanup; exit 4 ;; esac
  trusted_gate_relative=${trusted_gate_path#ops/}
  expected_systemd_blob=$("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
    rev-parse "$sha:$trusted_gate_path") || { fail "не смог проверить systemd tree для gate"; cleanup; exit 4; }
  if ! "$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
      show "$sha:$trusted_gate_path" >"$trusted_gate_root/ops/$trusted_gate_relative" \
    || ! "$TRUSTED_CHMOD" 444 "$trusted_gate_root/ops/$trusted_gate_relative" \
    || [ "$("$TRUSTED_GIT" hash-object "$trusted_gate_root/ops/$trusted_gate_relative")" != "$expected_systemd_blob" ]; then
    fail "не смог извлечь доверенное дерево systemd для gate"
    cleanup
    exit 4
  fi
  trusted_systemd_files=$((trusted_systemd_files + 1))
done < <("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
  ls-tree -r -z --name-only "$sha" -- ops/systemd)
[ "$trusted_systemd_files" -gt 0 ] \
  || { fail "в кандидате нет обязательного дерева systemd для gate"; cleanup; exit 4; }
for trusted_gate_path in ops/install-project-release-broker.sh ops/fx pilot/pilot.py pilot/context.md intake/app.py intake/plan.py; do
  expected_gate_dependency_blob=$("$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
    rev-parse "$sha:$trusted_gate_path") || { fail "в кандидате нет обязательной зависимости gate: $trusted_gate_path"; cleanup; exit 4; }
  if ! "$TRUSTED_GIT" -c safe.directory="$work/src" -C "$work/src" \
      show "$sha:$trusted_gate_path" >"$trusted_gate_root/$trusted_gate_path" \
    || [ "$("$TRUSTED_GIT" hash-object "$trusted_gate_root/$trusted_gate_path")" != "$expected_gate_dependency_blob" ]; then
    fail "не смог извлечь доверенную зависимость gate: $trusted_gate_path"
    cleanup
    exit 4
  fi
done
"$TRUSTED_CHMOD" 555 "$trusted_gate_root/ops/install-project-release-broker.sh" "$trusted_gate_root/ops/fx" \
  && "$TRUSTED_CHMOD" 444 "$trusted_gate_root/pilot/pilot.py" "$trusted_gate_root/pilot/context.md" \
    "$trusted_gate_root/intake/app.py" "$trusted_gate_root/intake/plan.py" \
  && "$TRUSTED_CHMOD" 711 "$trusted_gate_dir" "$trusted_gate_root/ops" "$trusted_gate_root/ops/systemd" \
    "$trusted_gate_root/pilot" "$trusted_gate_root/intake" \
  || { fail "не смог закрыть доверенный каталог gate"; cleanup; exit 4; }
if { [ "$("$TRUSTED_STAT" -Lc %u -- "$trusted_gate_dir")" != "$TRUSTED_OWNER_UID" ] \
  || [ "$("$TRUSTED_STAT" -Lc %a -- "$trusted_gate_dir")" != 711 ]; }; then
  fail "доверенный каталог gate допускает изменение рабочим пользователем"
