[[ "$server_version" == *"$current_sha"* && "$worker_version" == *"$current_sha"* ]] \
  || { fail "неизвестный или смешанный выпуск server/worker"; cleanup; exit 4; }

processes="$work/processes.tsv"
: >"$processes"
for unit in "$SERVER_SERVICE" $(worker_service_list) "$PILOT_SERVICE" "$INTAKE_SERVICE" "$BROKER_SERVICE"; do
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  case "$pid" in ''|0|*[!0-9]*) fail "у активной службы $unit нет MainPID"; cleanup; exit 4 ;; esac
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || { fail "не найден executable MainPID $pid ($unit)"; cleanup; exit 4; }
  case "$exe" in *' (deleted)') fail "процесс $unit использует deleted-inode"; cleanup; exit 4 ;; esac
  [ -f "$exe" ] || { fail "неизвестный executable $exe у $unit"; cleanup; exit 4; }
  exec_start=$(systemctl show -p ExecStart --value "$unit" 2>/dev/null)
  [ -n "$exec_start" ] && [[ "$exec_start" == *"$exe"* || "$unit" = "$PILOT_SERVICE" || "$unit" = "$INTAKE_SERVICE" ]] \
    || { fail "MainPID и ExecStart расходятся у $unit"; cleanup; exit 4; }
  printf '%s\t%s\t%s\t%s\n' "$unit" "$pid" "$exe" "$(sha256sum "$exe" | awk '{print $1}')" >>"$processes"
done

required_bytes=$(du -cb "$DATABASE" "$SERVER_BIN" "$WORKER_BIN" "$work/factory-server" "$work/factory-worker" 2>/dev/null | tail -1 | awk '{print int($1*2.25)}')
available_bytes=$(df -Pk "$REL" | awk 'NR==2 {print $4*1024}')
