json.dump({"name":"согласованный выпуск: "+subject,"sha":sha,"short":sha[:7],"ref":ref,
 "subject":subject,"at":at,"release_id":rid},open(p,"w"),ensure_ascii=False,sort_keys=True,separators=(",",":"))
