#!/bin/bash
# Собирает Фабрику из git и выкатывает её саму. Вызывается только из fx.
# Смысл: без этого любое изменение Фабрики приходится ставить руками,
# и система перестаёт быть самостоятельной.
set -uo pipefail
ref="${1:-main}"
REPO=https://github.com/timafen/factory.git
BIN=/opt/factory-data/bin/factory-server
REL=/opt/factory-data/releases/factory
INFO=/opt/factory-data/releases/factory-current.json
AS="sudo -H -u factory"

mkdir -p "$REL" && chown factory:factory "$REL"
mkdir -p "$(dirname "$INFO")" && chown factory:factory "$(dirname "$INFO")"

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }

work=$($AS mktemp -d "$REL/build-XXXXXX") || { fail "не смог создать папку сборки"; exit 4; }

step "беру исходники: $ref"
$AS git clone --quiet "$REPO" "$work/src" || { fail "не смог забрать репозиторий с GitHub"; rm -rf "$work"; exit 4; }
$AS git -C "$work/src" checkout --quiet -B fx-build "origin/$ref" 2>/dev/null \
  || $AS git -C "$work/src" checkout --quiet "$ref" 2>/dev/null \
  || { fail "нет такой точки сборки: $ref"; rm -rf "$work"; exit 4; }
sha=$($AS git -C "$work/src" rev-parse HEAD)
subject=$($AS git -C "$work/src" log -1 --pretty=%s)
step "собираю ${sha:0:7} — $subject"

step "ставлю зависимости интерфейса"
$AS bash -c "cd '$work/src/web' && npm ci --no-audit --no-fund --silent" \
  || { fail "npm ci не прошёл"; rm -rf "$work"; exit 4; }

step "проверяю типы интерфейса"
$AS bash -c "cd '$work/src/web' && npx tsc -p tsconfig.app.json --noEmit" \
  || { fail "в интерфейсе есть ошибки типов — релиз не поеду"; rm -rf "$work"; exit 5; }

step "собираю интерфейс"
$AS bash -c "cd '$work/src/web' && npx vite build" \
  || { fail "сборка интерфейса не прошла"; rm -rf "$work"; exit 5; }

step "собираю сервер"
$AS bash -c "cd '$work/src' && go build -o '$work/factory-server' ./cmd/factory-server" \
  || { fail "сборка сервера не прошла"; rm -rf "$work"; exit 5; }

step "сохраняю то, что работает сейчас"
cp -f "$BIN" "$BIN.prev" || { fail "не смог сохранить текущую версию"; rm -rf "$work"; exit 4; }

step "ставлю новую версию и перезапускаю"
cp -f "$work/factory-server" "$BIN.new" && chown factory:factory "$BIN.new" \
  && chmod 755 "$BIN.new" && mv -f "$BIN.new" "$BIN" \
  || { fail "не смог поставить бинарь"; rm -rf "$work"; exit 4; }
systemctl restart factory-server.service
sleep 5

code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' http://127.0.0.1:7337/api/v1/dashboard || echo 000)
if [ "$code" != "200" ]; then
  fail "после перезапуска Фабрика отвечает $code — возвращаю предыдущую версию"
  cp -f "$BIN.prev" "$BIN.new" && mv -f "$BIN.new" "$BIN"
  systemctl restart factory-server.service
  sleep 5
  back=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' http://127.0.0.1:7337/api/v1/dashboard || echo 000)
  echo "откат сделан, Фабрика отвечает $back"
  rm -rf "$work"
  exit 6
fi

if [ -x "$work/src/ops/install-brain.sh" ]; then
  bash "$work/src/ops/install-brain.sh" "$work/src" \
    || { fail "мозг не встал — сервер уже новый, мозг остался прежним"; }
fi

python3 - "$INFO" "$sha" "$subject" "$ref" "$(date -Is)" <<'PY'
import json, sys, datetime
p, sha, subj, ref, iso = sys.argv[1:6]
M = ["января","февраля","марта","апреля","мая","июня",
     "июля","августа","сентября","октября","ноября","декабря"]
d = datetime.datetime.fromisoformat(iso)
when = "%d %s, %02d:%02d" % (d.day, M[d.month - 1], d.hour, d.minute)
json.dump({"name": "релиз от %s, из %s: %s" % (when, ref, subj),
           "sha": sha, "short": sha[:7], "ref": ref,
           "subject": subj, "when": when, "at": iso},
          open(p, "w"), ensure_ascii=False, indent=2)
print("== выкачено: релиз от %s, из %s: %s (%s)" % (when, ref, subj, sha[:7]))
PY
chown factory:factory "$INFO" 2>/dev/null

rm -rf "$work"
ls -1dt "$REL"/build-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
exit 0
