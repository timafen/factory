 u,s=line.rstrip("\n").split("\t"); states.append({"unit":u,"state":s})
d={"format":1,"release_id":"bootstrap-"+sha[:12],"candidate_sha":sha,"ref":"installed","artifacts":items,"processes":proc,"services":states,"database":{"ledger":int(ledger)}}
r=(json.dumps(d,sort_keys=True,separators=(",",":"))+"\n").encode(); open(root+"/manifest.json","wb").write(r); open(root+"/manifest.sha256","w").write(hashlib.sha256(r).hexdigest()+"\n")
PY
  chmod 600 "$bootstrap/manifest.json" "$bootstrap/manifest.sha256" "$bootstrap/services.tsv"
  old_generation="$GENERATIONS/bootstrap-${current_sha:0:12}"
