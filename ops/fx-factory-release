#!/bin/bash
# Собирает Фабрику из git и выкатывает сервер и воркер одной ревизией.
set -uo pipefail

ref="${1:-main}"
REPO="${FACTORY_RELEASE_REPO:-https://github.com/timafen/factory.git}"
SERVER_BIN="${FACTORY_SERVER_BIN:-/opt/factory-data/bin/factory-server}"
WORKER_BIN="${FACTORY_WORKER_BIN:-/opt/factory-data/bin/factory-worker}"
REL="${FACTORY_RELEASE_DIR:-/opt/factory-data/releases/factory}"
INFO="${FACTORY_RELEASE_INFO:-/opt/factory-data/releases/factory-current.json}"
AS="${FACTORY_RELEASE_AS-sudo -H -u factory}"
OWNER="${FACTORY_RELEASE_OWNER-factory:factory}"
SERVER_SERVICE="${FACTORY_SERVER_SERVICE:-factory-server.service}"
WORKER_SERVICE="${FACTORY_WORKER_SERVICE:-factory-worker.service}"
WORKER_SERVICES="${FACTORY_WORKER_SERVICES:-$WORKER_SERVICE}"
WORKER_CONFIG="${FACTORY_WORKER_CONFIG:-/opt/factory-data/worker.toml}"
PILOT_SERVICE="${FACTORY_PILOT_SERVICE:-factory-pilot.service}"
API="${FACTORY_API_URL:-http://127.0.0.1:7337}"
REGISTER_ATTEMPTS="${FACTORY_REGISTER_ATTEMPTS:-12}"
REGISTER_DELAY="${FACTORY_REGISTER_DELAY:-5}"
LOCK="${FACTORY_RELEASE_LOCK:-/run/lock/factory-release.lock}"
GATE_READY_ATTEMPTS="${FACTORY_RELEASE_GATE_READY_ATTEMPTS:-500}"
GATE_STOP_ATTEMPTS="${FACTORY_RELEASE_GATE_STOP_ATTEMPTS:-100}"
GATE_POLL_DELAY="${FACTORY_RELEASE_GATE_POLL_DELAY:-0.01}"

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }
as_user() { if [ -n "$AS" ]; then $AS "$@"; else "$@"; fi; }
set_owner() { if [ -n "$OWNER" ]; then chown "$OWNER" "$@"; fi; }
worker_service_list() { printf '%s\n' $WORKER_SERVICES; }
stop_workers() { local service; while read -r service; do systemctl stop "$service" || return; done < <(worker_service_list); }
start_workers() { local service; while read -r service; do systemctl start "$service" || return; done < <(worker_service_list); }
restart_workers() { local service; while read -r service; do systemctl restart "$service" || return; done < <(worker_service_list); }

case "$GATE_READY_ATTEMPTS:$GATE_STOP_ATTEMPTS" in
  *[!0-9:]*|:*|*:) fail "некорректный лимит ожидания test gate"; exit 4 ;;
esac

mkdir -p "$(dirname "$LOCK")" || { fail "cannot prepare the Factory release lock"; exit 4; }
exec 9>"$LOCK" || { fail "cannot open the Factory release lock"; exit 4; }
flock -n 9 || { fail "another Factory release is already running"; exit 8; }

mkdir -p "$REL" && set_owner "$REL" || { fail "не смог подготовить папку релизов"; exit 4; }
mkdir -p "$(dirname "$INFO")" && set_owner "$(dirname "$INFO")" \
  || { fail "не смог подготовить release-info"; exit 4; }
work=$(as_user mktemp -d "$REL/build-XXXXXX") \
  || { fail "не смог создать папку сборки"; exit 4; }
gate_pids=()
gate_handshakes=()
gate_logs=()
gate_names=()
test_gates_stopped=1
test_gates_reaped=1
cleanup() {
  stop_test_gates
  wait_for_test_gates
  rm -rf "$work"
}
on_release_exit() { cleanup; }
trap on_release_exit EXIT

# UI-проверки и Go-ворота независимы, но установка может начаться только после
# их общего успеха. Реальную SID/PGID сообщает оболочка, уже запущенная через
# setsid: PID внешнего launcher ненадёжен, потому что GNU setsid и $AS могут
# forkнуть. До атомарной записи handshake ни $AS, ни сама команда не стартуют.
# Отдельная оболочка вокруг самой команды атомарно публикует её итоговый статус:
# статус $AS не авторитетен, потому что fork-обёртка может вернуть 0 раньше gate.
read_test_gate_handshake() { # read_test_gate_handshake <файл>; sets gate_sid/gate_pgid
  local handshake=$1 sid_field='' pgid_field='' ready_field='' extra=''
  gate_sid=''
  gate_pgid=''
  [ -s "$handshake" ] || return 1
  IFS=' ' read -r sid_field pgid_field ready_field extra <"$handshake" || return 1
  case "$sid_field:$pgid_field:$ready_field:$extra" in
    sid=*:pgid=*:ready=1:) ;;
    *) return 1 ;;
  esac
  gate_sid=${sid_field#sid=}
  gate_pgid=${pgid_field#pgid=}
  case "$gate_sid:$gate_pgid" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
  # A setsid wrapper is the session and process-group leader. Rejecting any
  # other record prevents a stale launcher PID from becoming a kill target.
  [ "$gate_sid" = "$gate_pgid" ]
}

wait_for_test_gate_handshake() { # wait_for_test_gate_handshake <файл>
  local handshake=$1 i
  for ((i = 0; i < GATE_READY_ATTEMPTS; i++)); do
    read_test_gate_handshake "$handshake" && return 0
    sleep "$GATE_POLL_DELAY"
  done
  read_test_gate_handshake "$handshake"
}

test_gate_group_alive() { kill -0 -- "-$1" 2>/dev/null; }

wait_for_test_gate_group_exit() { # wait_for_test_gate_group_exit <pgid>
  local pgid=$1 i
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    test_gate_group_alive "$pgid" || return 0
    sleep "$GATE_POLL_DELAY"
  done
  ! test_gate_group_alive "$pgid"
}

wait_for_test_gate_pids_exit() { # wait_for_test_gate_pids_exit <pid...>
  local i pid alive
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    alive=0
    for pid in "$@"; do
      if kill -0 "$pid" 2>/dev/null; then alive=1; break; fi
    done
    [ "$alive" = 0 ] && return 0
    sleep "$GATE_POLL_DELAY"
  done
  for pid in "$@"; do
    kill -0 "$pid" 2>/dev/null && return 1
  done
  return 0
}

test_gate_launcher_tree() { # test_gate_launcher_tree <launcher-pid>
  local parent=$1 child
  printf '%s\n' "$parent"
  while read -r child; do
    [ -n "$child" ] || continue
    test_gate_launcher_tree "$child"
  done < <(ps -eo pid=,ppid= | awk -v parent="$parent" '$2 == parent {print $1}')
}

reap_test_gate_launcher() { # reap_test_gate_launcher <launcher-pid>
  local launcher=$1
  if ! wait_for_test_gate_pids_exit "$launcher"; then
    kill -KILL "$launcher" 2>/dev/null || true
    wait_for_test_gate_pids_exit "$launcher" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

stop_unready_test_gate_launcher() { # stop_unready_test_gate_launcher <launcher-pid>
  local launcher=$1 i
  local -a tree=()
  mapfile -t tree < <(test_gate_launcher_tree "$launcher")
  for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
    kill -TERM "${tree[$i]}" 2>/dev/null || true
  done
  if ! wait_for_test_gate_pids_exit "${tree[@]}"; then
    for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
      kill -KILL "${tree[$i]}" 2>/dev/null || true
    done
    wait_for_test_gate_pids_exit "${tree[@]}" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

stop_ready_test_gate() { # stop_ready_test_gate <launcher-pid> <pgid>
  local launcher=$1 pgid=$2
  kill -TERM -- "-$pgid" 2>/dev/null || true
  if ! wait_for_test_gate_group_exit "$pgid"; then
    kill -KILL -- "-$pgid" 2>/dev/null || true
    wait_for_test_gate_group_exit "$pgid" || true
  fi
  reap_test_gate_launcher "$launcher"
}

start_test_gate() { # start_test_gate <имя> <журнал> <handshake> <команда...>
  local name=$1 log=$2 handshake=$3 result="${3}.result" launcher
  local -a as_command=()
  shift 3
  [ -z "$AS" ] || read -r -a as_command <<<"$AS"
  rm -f -- "$handshake" "$result"
  setsid --wait bash -c '
    handshake=$1
    result=$2
    as_count=$3
    stop_attempts=$4
    poll_delay=$5
    shift 5
    as_command=("${@:1:as_count}")
    shift "$as_count"
    trap - HUP INT TERM
    read -r sid pgid < <(ps -o sid= -o pgid= -p "$$") || exit 125
    case "$sid:$pgid" in
      *[!0-9:]*|:*|*:) exit 125 ;;
    esac
    [ "$sid" = "$pgid" ] || exit 125
    temporary_handshake=$(mktemp "${handshake}.tmp.XXXXXX") || exit 125
    if ! printf "sid=%s pgid=%s ready=1\\n" "$sid" "$pgid" >"$temporary_handshake" \
      || ! mv -f -- "$temporary_handshake" "$handshake"; then
      rm -f -- "$temporary_handshake"
      exit 125
    fi

    # This wrapper, rather than the possibly forking $AS launcher, observes the
    # real gate. Each state is published by rename so the supervisor never
    # accepts a partial or stale successful record.
    "${as_command[@]}" bash -c '\''
      result=$1
      shift
      publish_gate_result() {
        local contents=$1 temporary_result
        temporary_result=$(mktemp "${result}.tmp.XXXXXX") || return 1
        if ! printf "%s\\n" "$contents" >"$temporary_result" \
          || ! mv -f -- "$temporary_result" "$result"; then
          rm -f -- "$temporary_result"
          return 1
        fi
      }
      publish_gate_result "state=running pid=$$" || exit 125
      "$@"
      gate_status=$?
      publish_gate_result "state=finished status=$gate_status" || exit 125
      exit "$gate_status"
    '\'' bash "$result" "$@" &
    as_pid=$!
    wait "$as_pid"
    as_status=$?

    # A synchronous $AS has already waited for the writer. A forking $AS may
    # return first, so follow the published writer PID while it belongs to this
    # process group. Once it disappears, only bounded retries are allowed and
    # any missing/malformed final record fails closed.
    unsettled=0
    while :; do
      state_field= value_field= extra=
      if [ -s "$result" ] \
        && IFS=" " read -r state_field value_field extra <"$result"; then
        case "$state_field:$value_field:$extra" in
          state=finished:status=*:)
            gate_status=${value_field#status=}
            case "$gate_status" in
              ""|*[!0-9]*) exit 125 ;;
            esac
            [ "$gate_status" -le 255 ] || exit 125
            [ "$gate_status" -ne 0 ] && exit "$gate_status"
            [ "$as_status" -eq 0 ] || exit 125
            exit 0
            ;;
          state=running:pid=:*) ;;
          state=running:pid=*:)
            gate_pid=${value_field#pid=}
            case "$gate_pid" in
              ""|*[!0-9]*) gate_pid= ;;
            esac
            if [ -n "$gate_pid" ]; then
              actual_pgid= process_state=
              read -r actual_pgid process_state \
                < <(ps -o pgid= -o stat= -p "$gate_pid") || true
              case "$process_state" in Z*|"") ;; *)
                if [ "$actual_pgid" = "$pgid" ]; then
                  unsettled=0
                  sleep "$poll_delay"
                  continue
                fi
                ;;
              esac
            fi
            ;;
        esac
      fi
      ((unsettled++))
      [ "$unsettled" -lt "$stop_attempts" ] || exit 125
      sleep "$poll_delay"
    done
  ' bash "$handshake" "$result" "${#as_command[@]}" "$GATE_STOP_ATTEMPTS" \
    "$GATE_POLL_DELAY" "${as_command[@]}" "$@" >"$log" 2>&1 &
  launcher=$!
  gate_pids+=("$launcher")
  gate_handshakes+=("$handshake")
  gate_logs+=("$log")
  gate_names+=("$name")
  if wait_for_test_gate_handshake "$handshake"; then return 0; fi
  fail "не дождался handshake реальной session для $name"
  return 1
}

stop_test_gates() {
  local i launcher handshake
  [ "$test_gates_stopped" = 0 ] || return 0
  test_gates_stopped=1
  for i in "${!gate_pids[@]}"; do
    launcher=${gate_pids[$i]}
    handshake=${gate_handshakes[$i]}
    if wait_for_test_gate_handshake "$handshake"; then
      stop_ready_test_gate "$launcher" "$gate_pgid"
    else
      stop_unready_test_gate_launcher "$launcher"
    fi
  done
}

wait_for_test_gates() {
  local launcher
  [ "$test_gates_reaped" = 0 ] || return 0
  for launcher in "${gate_pids[@]}"; do
    reap_test_gate_launcher "$launcher"
  done
  test_gates_reaped=1
}

wait_for_test_gate_descendants() { # wait_for_test_gate_descendants <handshake>
  local handshake=$1
  read_test_gate_handshake "$handshake" || return 1
  while test_gate_group_alive "$gate_pgid"; do
    sleep "$GATE_POLL_DELAY"
  done
}

print_test_gate_logs() {
  local i
  for i in "${!gate_logs[@]}"; do
    step "полный вывод: ${gate_names[$i]}"
    cat "${gate_logs[$i]}"
  done
}

on_test_gate_signal() {
  local signal=$1
  trap - HUP INT TERM
  stop_test_gates
  wait_for_test_gates
  print_test_gate_logs
  cleanup
  exit 130
}

run_parallel_test_gates() {
  local completed status failed_name completed_index other_index
  gate_pids=()
  gate_handshakes=()
  gate_logs=()
  gate_names=()
  test_gates_stopped=0
  test_gates_reaped=0

  # A shell started as a background job can inherit ignored SIGINT. Reset it
  # before installing our handler so INT follows the same cleanup path.
  trap - HUP INT TERM
  trap 'on_test_gate_signal HUP' HUP
  trap 'on_test_gate_signal INT' INT
  trap 'on_test_gate_signal TERM' TERM

  if ! start_test_gate "UI-проверки" "$work/ui-checks.log" "$work/ui-checks.session" \
    bash -c 'cd "$1" && npx tsc -p tsconfig.app.json --noEmit && npm test' \
    bash "$work/src/web"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi
  if ! start_test_gate "Go-проверки и сценарий выката" "$work/go-checks.log" "$work/go-checks.session" \
    bash -c 'umask 077; cd "$1" && go test ./... && bash ops/test-fx-factory-release.sh' \
    bash "$work/src"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi

  wait -n -p completed "${gate_pids[@]}"
  status=$?
  if [ "$status" -ne 0 ]; then
    failed_name="параллельная группа проверок"
    if [ "$completed" = "${gate_pids[0]}" ]; then failed_name="${gate_names[0]}"; fi
    if [ "$completed" = "${gate_pids[1]}" ]; then failed_name="${gate_names[1]}"; fi
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "$failed_name завершилась с кодом $status"
    return 1
  fi

  completed_index=1
  [ "$completed" = "${gate_pids[0]}" ] && completed_index=0
  if ! wait_for_test_gate_descendants "${gate_handshakes[$completed_index]}"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "не смог подтвердить завершение process group ${gate_names[$completed_index]}"
    return 1
  fi

  other_index=0
  [ "$completed_index" = 0 ] && other_index=1
  wait "${gate_pids[$other_index]}"
  status=$?
  if [ "$status" -eq 0 ] \
    && ! wait_for_test_gate_descendants "${gate_handshakes[$other_index]}"; then
    status=1
  fi
  if [ "$status" -ne 0 ]; then
    stop_test_gates
    wait_for_test_gates
    fail "${gate_names[$other_index]} завершилась с кодом $status"
  fi
  trap - HUP INT TERM
  print_test_gate_logs
  if [ "$status" -eq 0 ]; then
    test_gates_stopped=1
    test_gates_reaped=1
  fi
  [ "$status" -eq 0 ]
}

step "беру исходники: $ref"
as_user git clone --quiet "$REPO" "$work/src" \
  || { fail "не смог забрать репозиторий с GitHub"; cleanup; exit 4; }
as_user git -C "$work/src" checkout --quiet -B fx-build "origin/$ref" 2>/dev/null \
  || as_user git -C "$work/src" checkout --quiet "$ref" 2>/dev/null \
  || { fail "нет такой точки сборки: $ref"; cleanup; exit 4; }
sha=$(as_user git -C "$work/src" rev-parse HEAD)
subject=$(as_user git -C "$work/src" log -1 --pretty=%s)
case "$subject" in
  "Merge pull request #"*)
    merged_title=$(as_user git -C "$work/src" log -1 --pretty=%B \
      | sed '1d; /^[[:space:]]*$/d' | head -n 1)
    [ -z "$merged_title" ] || subject=$merged_title
    ;;
esac
subject=$(printf '%s' "$subject" | sed -E 's/[[:space:]]+\(#[0-9]+\)$//')
[ -n "$subject" ] || subject="Обновление Factory"
step "собираю изменение: $subject"

step "ставлю зависимости интерфейса"
as_user bash -c "cd '$work/src/web' && npm ci --no-audit --no-fund --silent" \
  || { fail "npm ci не прошёл"; cleanup; exit 4; }
step "параллельно проверяю интерфейс, Go и сценарий выката"
run_parallel_test_gates \
  || { fail "одна из обязательных проверок не прошла — релиз не поеду"; cleanup; exit 5; }
step "собираю интерфейс"
as_user bash -c "cd '$work/src/web' && npx vite build" \
  || { fail "сборка интерфейса не прошла"; cleanup; exit 5; }
step "собираю сервер и воркер"
as_user bash -c "cd '$work/src' && go build -o '$work/factory-server' ./cmd/factory-server" \
  && as_user bash -c "cd '$work/src' && go build -o '$work/factory-worker' ./cmd/factory-worker" \
  && as_user bash -c "cd '$work/src' && go build -o '$work/factory-release-broker' ./cmd/factory-release-broker" \
  || { fail "сборка сервера, воркера или release-broker не прошла"; cleanup; exit 5; }

step "ставлю привилегированный broker выпусков"
bash "$work/src/ops/install-project-release-broker.sh" \
  "$work/factory-release-broker" "$work/src/ops/systemd/factory-release-broker.service" \
  || { fail "release-broker не установлен безопасно"; cleanup; exit 5; }

step "проверяю и обновляю ссылки авторизации Codex"
env -u CODEX_HOME bash "$work/src/ops/provision-codex-auth.sh" \
  || { fail "авторизация Codex не прошла безопасную проверку — релиз не поеду"; cleanup; exit 5; }

step "сохраняю работающую пару бинарей"
cp -f "$SERVER_BIN" "$work/factory-server.prev" \
  && cp -f "$WORKER_BIN" "$work/factory-worker.prev" \
  || { fail "не смог сохранить текущие сервер и воркер"; cleanup; exit 4; }

# Снимок release-info нужен до первой операции, которая может вызвать rollback:
# ранний отказ установки сервера, воркера, control-команд или brain не должен
# потерять корректные сведения о прежнем выпуске.
info_previous_exists=0
if [ -e "$INFO" ]; then
  cp -f "$INFO" "$work/release-info.prev" \
    || { fail "не смог сохранить прежние сведения о выпуске"; cleanup; exit 4; }
  info_previous_exists=1
fi

rollback() {
  trap - EXIT HUP INT TERM
  rollback_armed=0
  fail "$1 — возвращаю предыдущие сервер и воркер"
  cp -f "$work/factory-server.prev" "$SERVER_BIN.new" \
    && mv -f "$SERVER_BIN.new" "$SERVER_BIN"
  cp -f "$work/factory-worker.prev" "$WORKER_BIN.new" \
    && mv -f "$WORKER_BIN.new" "$WORKER_BIN"
  if [ "${info_previous_exists:-0}" = 1 ]; then
    cp -f "$work/release-info.prev" "$INFO.new" \
      && mv -f "$INFO.new" "$INFO"
  else
    rm -f "$INFO"
  fi
  systemctl restart "$SERVER_SERVICE" || true
  restart_workers || true
  cleanup
  exit "$2"
}

rollback_armed=1
on_exit() {
  status=$?
  [ "$rollback_armed" = 1 ] || return
  [ "$status" -ne 0 ] || status=130
  rollback "выпуск прерван до подтверждения новой пары" "$status"
}
on_signal() { rollback "выпуск прерван сигналом $1" 130; }
trap on_exit EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

install_binary() {
  source=$1 target=$2
  cp -f "$source" "$target.new" && set_owner "$target.new" \
    && chmod 755 "$target.new" && mv -f "$target.new" "$target"
}

step "ставлю новую пару и перезапускаю сервер"
install_binary "$work/factory-server" "$SERVER_BIN" || rollback "не смог поставить сервер" 4
install_binary "$work/factory-worker" "$WORKER_BIN" || rollback "не смог поставить воркер" 4
systemctl restart "$SERVER_SERVICE" || rollback "сервер не перезапустился" 6
sleep 5

code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)
[ "$code" = "200" ] || rollback "после перезапуска Фабрика отвечает $code" 6

stop_workers || rollback "воркеры не остановились" 6
worker_id=''
identity_error="$work/worker-identity-error"
identity_attempt=1
while [ "$identity_attempt" -le 5 ]; do
  if worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>"$identity_error") \
    && [ -n "$worker_id" ]; then
    break
  fi
  worker_id=''
  identity_attempt=$((identity_attempt + 1))
  [ "$identity_attempt" -gt 5 ] || sleep 1
done
if [ -z "$worker_id" ]; then
  identity_detail=$(tr '\n' ' ' <"$identity_error" | cut -c1-300)
  [ -z "$identity_detail" ] || fail "причина identity: $identity_detail"
  rollback "не удалось определить identity воркера после пяти попыток" 6
fi
previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c \
  'import json,sys
try: print(json.load(sys.stdin).get("last_heartbeat", ""))
except Exception: print("")' 2>/dev/null)
start_workers || rollback "воркеры не запустились" 6

step "жду здоровую регистрацию воркера $worker_id"
registered=0
attempt=1
while [ "$attempt" -le "$REGISTER_ATTEMPTS" ]; do
  body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
  if printf '%s' "$body" | python3 -c \
    'import datetime,json,sys
try:
 w=json.load(sys.stdin); current=w.get("last_heartbeat", "")
 fresh=bool(current) and (not sys.argv[2] or datetime.datetime.fromisoformat(current.replace("Z", "+00:00")) > datetime.datetime.fromisoformat(sys.argv[2].replace("Z", "+00:00")))
 ok=w.get("id") == sys.argv[1] and w.get("health") == "healthy" and w.get("online") is True and fresh
except Exception: ok=False
raise SystemExit(not ok)' \
    "$worker_id" "$previous_heartbeat" 2>/dev/null; then
    registered=1
    break
  fi
  attempt=$((attempt + 1))
  [ "$attempt" -gt "$REGISTER_ATTEMPTS" ] || sleep "$REGISTER_DELAY"
done
[ "$registered" = 1 ] || rollback "воркер $worker_id не зарегистрировался здоровым" 6

step "обновляю штатные команды управления Фабрикой"
bash "$work/src/ops/install-factory-control.sh" "$work/src" \
  || rollback "не смог обновить fx и драйвер выпуска" 7

deferred_pilot_restart=0
brain_restart_marker="$work/restart-pilot"
if [ -x "$work/src/ops/install-brain.sh" ]; then
    FACTORY_BRAIN_DEFER_PILOT_RESTART=1 \
    FACTORY_BRAIN_RESTART_MARKER="$brain_restart_marker" \
    bash "$work/src/ops/install-brain.sh" "$work/src" \
    || rollback "мозг не встал" 7
  [ ! -f "$brain_restart_marker" ] || deferred_pilot_restart=1
fi
if [ -f "$work/src/ops/factory-janitor.sh" ]; then
  janitor_bin="${FACTORY_JANITOR_BIN:-/usr/local/bin/factory-janitor.sh}"
  install -o root -g root -m 755 "$work/src/ops/factory-janitor.sh" "$janitor_bin" \
    || fail "санитар воркеров не обновился — сервер и воркер уже обновлены"
fi

step "ставлю и проверяю изолированный серверный браузер"
bash "$work/src/ops/install-server-browser.sh" \
  || rollback "серверный браузер не прошёл сетевую проверку" 7

if ! python3 - "$INFO" "$sha" "$subject" "$ref" "$(date -Is)" <<'PY'
import json, sys, datetime
p, sha, subj, ref, iso = sys.argv[1:6]
M = ["января","февраля","марта","апреля","мая","июня",
     "июля","августа","сентября","октября","ноября","декабря"]
d = datetime.datetime.fromisoformat(iso)
when = "%d %s, %02d:%02d" % (d.day, M[d.month - 1], d.hour, d.minute)
json.dump({"name": "релиз от %s, из %s: %s" % (when, ref, subj),
           "sha": sha, "short": sha[:7], "ref": ref,
           "subject": subj, "when": when, "at": iso},
          open(p, "w"), ensure_ascii=False, indent=2)
print("== выкачено: релиз от %s, из %s: %s" % (when, ref, subj))
PY
then
  rollback "не смог записать сведения о выпуске" 7
fi
set_owner "$INFO" 2>/dev/null || true

if [ "$deferred_pilot_restart" = 1 ]; then
  step "ставлю безопасный отложенный перезапуск Пилота"
  systemd-run --quiet --collect --unit="factory-pilot-restart-$$" --on-active=30s \
    /usr/bin/flock -n "$LOCK" /bin/systemctl restart "$PILOT_SERVICE" \
    || rollback "не смог отложить перезапуск Пилота" 7
fi

rollback_armed=0
cleanup
ls -1dt "$REL"/build-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
exit 0
