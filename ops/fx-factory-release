#!/bin/bash
# Собирает Фабрику из git и выкатывает сервер и воркер одной ревизией.
set -uo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

ref="${1:-main}"
REPO="${FACTORY_RELEASE_REPO:-https://github.com/timafen/factory.git}"
SERVER_BIN="${FACTORY_SERVER_BIN:-/opt/factory-data/bin/factory-server}"
WORKER_BIN="${FACTORY_WORKER_BIN:-/opt/factory-data/bin/factory-worker}"
REL="${FACTORY_RELEASE_DIR:-/opt/factory-data/releases/factory}"
INFO="${FACTORY_RELEASE_INFO:-/opt/factory-data/releases/factory-current.json}"
AS="${FACTORY_RELEASE_AS-sudo -H -u factory}"
OWNER="${FACTORY_RELEASE_OWNER-factory:factory}"
SERVER_SERVICE="${FACTORY_SERVER_SERVICE:-factory-server.service}"
WORKER_SERVICE="${FACTORY_WORKER_SERVICE:-factory-worker.service}"
WORKER_SERVICES="${FACTORY_WORKER_SERVICES:-$WORKER_SERVICE}"
WORKER_CONFIG="${FACTORY_WORKER_CONFIG:-/opt/factory-data/worker.toml}"
PILOT_SERVICE="${FACTORY_PILOT_SERVICE:-factory-pilot.service}"
API="${FACTORY_API_URL:-http://127.0.0.1:7337}"
REGISTER_ATTEMPTS="${FACTORY_REGISTER_ATTEMPTS:-12}"
REGISTER_DELAY="${FACTORY_REGISTER_DELAY:-5}"
LOCK="${FACTORY_RELEASE_LOCK:-/run/lock/factory-release.lock}"
GATE_READY_ATTEMPTS="${FACTORY_RELEASE_GATE_READY_ATTEMPTS:-500}"
GATE_STOP_ATTEMPTS="${FACTORY_RELEASE_GATE_STOP_ATTEMPTS:-100}"
GATE_POLL_DELAY="${FACTORY_RELEASE_GATE_POLL_DELAY:-0.01}"
TRUSTED_OWNER_UID=0
TRUSTED_SOURCE_ROOT=/run/factory-release-gate
TRUSTED_SETSID=/usr/bin/setsid
TRUSTED_SUDO=/usr/bin/sudo
TRUSTED_BASH=/bin/bash
TRUSTED_ENV=/usr/bin/env
TRUSTED_GIT=/usr/bin/git
TRUSTED_STAT=/usr/bin/stat
TRUSTED_CHMOD=/bin/chmod
TRUSTED_MKDIR=/bin/mkdir
TRUSTED_MKTEMP=/usr/bin/mktemp
TRUSTED_MV=/usr/bin/mv
TRUSTED_RM=/usr/bin/rm
TRUSTED_SLEEP=/bin/sleep
TRUSTED_OD=/usr/bin/od
TRUSTED_PS=/usr/bin/ps
TRUSTED_AWK=/usr/bin/awk
TRUSTED_NODE=/usr/bin/node
TRUSTED_NPX_CLI=/usr/lib/node_modules/npm/bin/npx-cli.js
TRUSTED_NPM_CLI=/usr/lib/node_modules/npm/bin/npm-cli.js
TRUSTED_GO=/usr/bin/go
TRUSTED_GATE_CGROUP=/usr/local/libexec/factory-gate-cgroup
CONTROL_FX_TARGET=${FACTORY_FX_BIN:-/usr/local/bin/fx}
CONTROL_RELEASE_TARGET=${FACTORY_RELEASE_DRIVER:-/usr/local/lib/fx-factory-release}
BROKER_BIN_TARGET=${FACTORY_RELEASE_BROKER_BIN:-/opt/factory-data/bin/factory-release-broker}
BROKER_UNIT_TARGET=${FACTORY_RELEASE_BROKER_UNIT:-/etc/systemd/system/factory-release-broker.service}
BROKER_PILOT_DROPIN_TARGET=${FACTORY_RELEASE_BROKER_PILOT_DROPIN:-/etc/systemd/system/factory-pilot.service.d/50-project-release-broker.conf}
BROKER_LEGACY_DROPIN_TARGET=${FACTORY_RELEASE_BROKER_LEGACY_SERVER_DROPIN:-/etc/systemd/system/factory-server.service.d/50-project-release-broker.conf}
TRUSTED_DIRNAME=/usr/bin/dirname
TRUSTED_FLOCK=/usr/bin/flock
TRUSTED_CHOWN=/usr/bin/chown
TRUSTED_SYSTEMCTL=/usr/bin/systemctl
TRUSTED_CAT=/usr/bin/cat
TRUSTED_SED=/usr/bin/sed
TRUSTED_HEAD=/usr/bin/head
TRUSTED_CP=/usr/bin/cp
TRUSTED_CURL=/usr/bin/curl
TRUSTED_INSTALL=/usr/bin/install
TRUSTED_LS=/usr/bin/ls
TRUSTED_TAIL=/usr/bin/tail
TRUSTED_XARGS=/usr/bin/xargs
TRUSTED_TR=/usr/bin/tr
TRUSTED_CUT=/usr/bin/cut
TRUSTED_PYTHON=/usr/bin/python3
TRUSTED_DATE=/usr/bin/date
TRUSTED_SYSTEMD_RUN=/usr/bin/systemd-run
TRUSTED_PATH=/usr/bin:/bin

step() { echo "== $*"; }
fail() { echo "!! $*" >&2; }
as_user() { if [ "${#gate_identity[@]}" -gt 0 ]; then "${gate_identity[@]}" "$@"; else "$@"; fi; }
trusted_node() { "$TRUSTED_ENV" PATH="$TRUSTED_PATH" "$TRUSTED_NODE" "$@"; }
set_owner() { if [ -n "$OWNER" ]; then "$TRUSTED_CHOWN" "$OWNER" "$@"; fi; }
worker_service_list() { printf '%s\n' $WORKER_SERVICES; }
stop_workers() { local service; while read -r service; do "$TRUSTED_SYSTEMCTL" stop "$service" || return; done < <(worker_service_list); }
start_workers() { local service; while read -r service; do "$TRUSTED_SYSTEMCTL" start "$service" || return; done < <(worker_service_list); }
restart_workers() { local service; while read -r service; do "$TRUSTED_SYSTEMCTL" restart "$service" || return; done < <(worker_service_list); }

case "$GATE_READY_ATTEMPTS:$GATE_STOP_ATTEMPTS" in
  *[!0-9:]*|:*|*:) fail "некорректный лимит ожидания test gate"; exit 4 ;;
esac

validate_trusted_executable() { # validate_trusted_executable <absolute path>
  local executable=$1 owner mode
  case "$executable" in /*) ;; *) return 1 ;; esac
  [ -f "$executable" ] && [ -x "$executable" ] || return 1
  owner=$("$TRUSTED_STAT" -Lc %u -- "$executable" 2>/dev/null) || return 1
  mode=$("$TRUSTED_STAT" -Lc %a -- "$executable" 2>/dev/null) || return 1
  [ "$owner" = "$TRUSTED_OWNER_UID" ] || return 1
  (( (8#$mode & 0022) == 0 ))
}

for trusted_executable in "$TRUSTED_STAT" "$TRUSTED_SETSID" "$TRUSTED_SUDO" \
  "$TRUSTED_BASH" "$TRUSTED_CHMOD" "$TRUSTED_MKDIR" "$TRUSTED_MKTEMP" "$TRUSTED_MV" "$TRUSTED_RM" \
  "$TRUSTED_SLEEP" "$TRUSTED_OD" "$TRUSTED_PS" "$TRUSTED_AWK" \
  "$TRUSTED_ENV" "$TRUSTED_GIT" "$TRUSTED_NODE" "$TRUSTED_NPX_CLI" \
  "$TRUSTED_NPM_CLI" "$TRUSTED_GO"; do
  validate_trusted_executable "$trusted_executable" \
    || { fail "нет доверенного executable для test gate: $trusted_executable"; exit 4; }
done

for trusted_executable in "$TRUSTED_DIRNAME" "$TRUSTED_FLOCK" \
  "$TRUSTED_CHOWN" "$TRUSTED_SYSTEMCTL" "$TRUSTED_CAT" "$TRUSTED_SED" "$TRUSTED_HEAD" \
  "$TRUSTED_CP" "$TRUSTED_CURL" "$TRUSTED_INSTALL" "$TRUSTED_LS" "$TRUSTED_TAIL" "$TRUSTED_XARGS" \
  "$TRUSTED_TR" "$TRUSTED_CUT" "$TRUSTED_PYTHON" "$TRUSTED_DATE" "$TRUSTED_SYSTEMD_RUN"; do
  validate_trusted_executable "$trusted_executable" \
    || { fail "нет доверенного executable для release chain: $trusted_executable"; exit 4; }
done

# A caller-provided launcher must never control checkout or gate inputs. Keep
# the historical empty no-switch mode for hermetic/operator use and accept the
# production default spelling, but reject every alternate wrapper before any
# source is obtained or any gate/install command can run.
case "$AS" in
  ''|'sudo -H -u factory') ;;
  *) fail "FACTORY_RELEASE_AS не может управлять доверенным checkout"; exit 4 ;;
esac

# $AS is intentionally not used. The gate/build identity comes from OWNER and
# is entered through one fixed, root-owned launcher whose wait status is
# authoritative. OWNER='' is the explicit no-switch mode used by the hermetic
# test fixture (and by an operator already running as the target UID).
gate_identity=()
if [ -n "$OWNER" ]; then
  gate_user=${OWNER%%:*}
  if ! [[ "$gate_user" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
    fail "некорректный пользователь для test gate"
    exit 4
  fi
  gate_identity=("$TRUSTED_SUDO" -H -u "$gate_user" --)
fi

"$TRUSTED_MKDIR" -p "$("$TRUSTED_DIRNAME" -- "$LOCK")" || { fail "cannot prepare the Factory release lock"; exit 4; }
exec 9>"$LOCK" || { fail "cannot open the Factory release lock"; exit 4; }
"$TRUSTED_FLOCK" -n 9 || { fail "another Factory release is already running"; exit 8; }

"$TRUSTED_MKDIR" -p "$REL" && set_owner "$REL" || { fail "не смог подготовить папку релизов"; exit 4; }
"$TRUSTED_MKDIR" -p "$("$TRUSTED_DIRNAME" -- "$INFO")" && set_owner "$("$TRUSTED_DIRNAME" -- "$INFO")" \
  || { fail "не смог подготовить release-info"; exit 4; }
work=$(as_user "$TRUSTED_MKTEMP" -d "$REL/build-XXXXXX") \
  || { fail "не смог создать папку сборки"; exit 4; }
trusted_work=''
gate_pids=()
gate_pgids=()
gate_ready=()
gate_logs=()
gate_names=()
gate_cgroups=()
test_gates_stopped=1
test_gates_reaped=1
cleanup() {
  stop_test_gates
  wait_for_test_gates
  "$TRUSTED_RM" -rf -- "$work"
  if [ -n "$trusted_work" ]; then
    "$TRUSTED_CHMOD" -R u+w "$trusted_work" 2>/dev/null || true
    "$TRUSTED_RM" -rf -- "$trusted_work"
  fi
}
on_release_exit() { cleanup; }
trap on_release_exit EXIT

# UI-проверки и Go-ворота независимы, но установка может начаться только после
# их общего успеха. Реальную SID/PGID сообщает оболочка, уже запущенная через
# setsid: PID внешнего launcher ненадёжен, потому что GNU setsid может forkнуть.
# До атомарной записи handshake сама команда gate не стартует.
# $AS не участвует в запуске gate: равноправный launcher мог бы подменить любой
# файл или канал того же UID. Фиксированный identity launcher и setsid --fork --wait
# образуют waitable-цепочку, чей одноразовый exit status сообщает само ядро.
process_identity() { # process_identity <pid>; sets process_state/ppid/pgid/sid
  local pid=$1 stat rest
  process_state=''
  process_ppid=''
  process_pgid=''
  process_sid=''
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$pid/stat" ] || return 1
  IFS= read -r stat <"/proc/$pid/stat" || return 1
  rest=${stat##*) }
  read -r process_state process_ppid process_pgid process_sid _ <<<"$rest"
  [ "$process_state" != Z ] || return 1
  case "$process_ppid:$process_pgid:$process_sid" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
}

read_test_gate_handshake() { # read_test_gate_handshake <file> <launcher> <nonce>
  local handshake=$1 launcher=$2 expected_nonce=$3
  local sid_field='' pgid_field='' nonce_field='' ready_field='' extra=''
  gate_sid=''
  gate_pgid=''
  [ -s "$handshake" ] || return 1
  IFS=' ' read -r sid_field pgid_field nonce_field ready_field extra <"$handshake" || return 1
  case "$sid_field:$pgid_field:$nonce_field:$ready_field:$extra" in
    sid=*:pgid=*:nonce=*:ready=1:) ;;
    *) return 1 ;;
  esac
  gate_sid=${sid_field#sid=}
  gate_pgid=${pgid_field#pgid=}
  [ "${nonce_field#nonce=}" = "$expected_nonce" ] || return 1
  case "$gate_sid:$gate_pgid" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
  [ "$gate_sid" = "$gate_pgid" ] || return 1
  process_identity "$launcher" || return 1
  process_identity "$gate_sid" || return 1
  # --fork makes the launched setsid process a stable supervisor. Its one
  # direct child must be the live session/process-group leader that published
  # this launch's nonce. A numeric, stale or unrelated process is never ready.
  [ "$process_ppid" = "$launcher" ] \
    && [ "$process_pgid" = "$gate_pgid" ] \
    && [ "$process_sid" = "$gate_sid" ] \
    && test_gate_group_alive "$gate_pgid"
}

publish_test_gate_ack() { # publish_test_gate_ack <file> <nonce>
  local ack=$1 nonce=$2 temporary_ack
  temporary_ack=$($TRUSTED_MKTEMP "${ack}.tmp.XXXXXX") || return 1
  if ! printf 'nonce=%s accepted=1\n' "$nonce" >"$temporary_ack" \
    || ! "$TRUSTED_MV" -f -- "$temporary_ack" "$ack"; then
    "$TRUSTED_RM" -f -- "$temporary_ack"
    return 1
  fi
}

wait_for_test_gate_handshake() { # wait_for_test_gate_handshake <file> <launcher> <nonce> <ack>
  local handshake=$1 launcher=$2 nonce=$3 ack=$4 i
  for ((i = 0; i < GATE_READY_ATTEMPTS; i++)); do
    if read_test_gate_handshake "$handshake" "$launcher" "$nonce"; then
      publish_test_gate_ack "$ack" "$nonce"
      return
    fi
    process_identity "$launcher" || return 1
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  read_test_gate_handshake "$handshake" "$launcher" "$nonce" \
    && publish_test_gate_ack "$ack" "$nonce"
}

test_gate_group_alive() { kill -0 -- "-$1" 2>/dev/null; }

wait_for_test_gate_group_exit() { # wait_for_test_gate_group_exit <pgid>
  local pgid=$1 i
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    test_gate_group_alive "$pgid" || return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  ! test_gate_group_alive "$pgid"
}

wait_for_test_gate_pids_exit() { # wait_for_test_gate_pids_exit <pid...>
  local i pid alive
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    alive=0
    for pid in "$@"; do
      if kill -0 "$pid" 2>/dev/null; then alive=1; break; fi
    done
    [ "$alive" = 0 ] && return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  for pid in "$@"; do
    kill -0 "$pid" 2>/dev/null && return 1
  done
  return 0
}

test_gate_launcher_tree() { # test_gate_launcher_tree <launcher-pid>
  local parent=$1 child
  printf '%s\n' "$parent"
  while read -r child; do
    [ -n "$child" ] || continue
    test_gate_launcher_tree "$child"
  done < <("$TRUSTED_PS" -eo pid=,ppid= \
    | "$TRUSTED_AWK" -v parent="$parent" '$2 == parent {print $1}')
}

reap_test_gate_launcher() { # reap_test_gate_launcher <launcher-pid>
  local launcher=$1
  if ! wait_for_test_gate_pids_exit "$launcher"; then
    kill -KILL "$launcher" 2>/dev/null || true
    wait_for_test_gate_pids_exit "$launcher" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

wait_for_gate_launcher_stop() { # wait_for_gate_launcher_stop <pid>
  local launcher=$1 i launcher_stat launcher_rest
  for ((i = 0; i < GATE_READY_ATTEMPTS; i++)); do
    [ -r "/proc/$launcher/stat" ] || return 1
    process_identity "$launcher" || {
      # A deliberately stopped process is still a valid live process.
      IFS= read -r launcher_stat <"/proc/$launcher/stat" || return 1
      launcher_rest=${launcher_stat##*) }
      read -r process_state _ <<<"$launcher_rest"
    }
    [ "$process_state" = T ] && return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  return 1
}

wait_for_gate_cgroup_empty() { # wait_for_gate_cgroup_empty <name>
  local cgroup=$1 i
  for ((i = 0; i < GATE_STOP_ATTEMPTS; i++)); do
    "$TRUSTED_GATE_CGROUP" empty "$cgroup" && return 0
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
  "$TRUSTED_GATE_CGROUP" empty "$cgroup"
}

drain_gate_cgroup() { # drain_gate_cgroup <name>
  local cgroup=$1 clean=0
  if wait_for_gate_cgroup_empty "$cgroup"; then
    clean=1
  else
    "$TRUSTED_GATE_CGROUP" signal "$cgroup" TERM || true
    if ! wait_for_gate_cgroup_empty "$cgroup"; then
      "$TRUSTED_GATE_CGROUP" signal "$cgroup" KILL || true
      wait_for_gate_cgroup_empty "$cgroup" || return 1
    fi
  fi
  "$TRUSTED_GATE_CGROUP" remove "$cgroup" || return 1
  [ "$clean" = 1 ]
}

stop_unready_test_gate_launcher() { # stop_unready_test_gate_launcher <launcher-pid>
  local launcher=$1 i
  local -a tree=()
  mapfile -t tree < <(test_gate_launcher_tree "$launcher")
  for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
    kill -TERM "${tree[$i]}" 2>/dev/null || true
  done
  if ! wait_for_test_gate_pids_exit "${tree[@]}"; then
    for ((i = ${#tree[@]} - 1; i >= 0; i--)); do
      kill -KILL "${tree[$i]}" 2>/dev/null || true
    done
    wait_for_test_gate_pids_exit "${tree[@]}" || true
  fi
  wait "$launcher" 2>/dev/null || true
}

stop_ready_test_gate() { # stop_ready_test_gate <launcher-pid> <pgid> <cgroup>
  local launcher=$1 pgid=$2 cgroup=$3
  "$TRUSTED_GATE_CGROUP" signal "$cgroup" TERM 2>/dev/null || true
  kill -TERM -- "-$pgid" 2>/dev/null || true
  if ! wait_for_gate_cgroup_empty "$cgroup" || ! wait_for_test_gate_group_exit "$pgid"; then
    "$TRUSTED_GATE_CGROUP" signal "$cgroup" KILL 2>/dev/null || true
    kill -KILL -- "-$pgid" 2>/dev/null || true
    wait_for_gate_cgroup_empty "$cgroup" || true
    wait_for_test_gate_group_exit "$pgid" || true
  fi
  reap_test_gate_launcher "$launcher"
  "$TRUSTED_GATE_CGROUP" remove "$cgroup" 2>/dev/null || true
}

start_test_gate() { # start_test_gate <имя> <журнал> <handshake> <команда...>
  local name=$1 log=$2 handshake=$3 launcher nonce ack cgroup
  shift 3
  ack="${handshake}.ack"
  nonce=$("$TRUSTED_OD" -An -N16 -tx1 /dev/urandom) || return 1
  nonce=${nonce//[[:space:]]/}
  [ "${#nonce}" -eq 32 ] || return 1
  cgroup="factory-release-gate-$nonce"
  "$TRUSTED_GATE_CGROUP" create "$cgroup" || return 1
  gate_cgroups+=("$cgroup")
  "$TRUSTED_RM" -f -- "$handshake" "$ack"
  "$TRUSTED_BASH" -c '
    trap - INT
    kill -STOP "$$"
    exec "$@"
  ' "$TRUSTED_BASH" "$TRUSTED_SETSID" --fork --wait "$TRUSTED_BASH" -c '
    handshake=$1
    ack=$2
    nonce=$3
    poll_delay=$4
    trusted_mktemp=$5
    trusted_mv=$6
    trusted_rm=$7
    trusted_sleep=$8
    shift 8
    trap - HUP INT TERM
    stat=$(<"/proc/$$/stat") || exit 125
    rest=${stat##*) }
    read -r state ppid pgid sid _ <<<"$rest"
    case "$sid:$pgid" in
      *[!0-9:]*|:*|*:) exit 125 ;;
    esac
    [ "$sid" = "$pgid" ] || exit 125
    temporary_handshake=$("$trusted_mktemp" "${handshake}.tmp.XXXXXX") || exit 125
    if ! printf "sid=%s pgid=%s nonce=%s ready=1\\n" "$sid" "$pgid" "$nonce" >"$temporary_handshake" \
      || ! "$trusted_mv" -f -- "$temporary_handshake" "$handshake"; then
      "$trusted_rm" -f -- "$temporary_handshake"
      exit 125
    fi

    accepted=
    for ((i = 0; i < 500; i++)); do
      nonce_field= accepted_field= extra=
      if [ -s "$ack" ]; then
        IFS=" " read -r nonce_field accepted_field extra <"$ack" || true
      fi
      if [ "$nonce_field" = "nonce=$nonce" ] \
        && [ "$accepted_field" = accepted=1 ] && [ -z "$extra" ]; then
        accepted=1
        break
      fi
      "$trusted_sleep" "$poll_delay"
    done
    [ "$accepted" = 1 ] || exit 125

    exec "$@"
  ' "$TRUSTED_BASH" "$handshake" "$ack" "$nonce" "$GATE_POLL_DELAY" \
    "$TRUSTED_MKTEMP" "$TRUSTED_MV" "$TRUSTED_RM" "$TRUSTED_SLEEP" \
    "${gate_identity[@]}" "$@" >"$log" 2>&1 &
  launcher=$!
  gate_pids+=("$launcher")
  gate_pgids+=("")
  gate_ready+=(0)
  gate_logs+=("$log")
  gate_names+=("$name")
  if ! wait_for_gate_launcher_stop "$launcher" \
    || ! "$TRUSTED_GATE_CGROUP" attach "$cgroup" "$launcher"; then
    kill -KILL "$launcher" 2>/dev/null || true
    wait "$launcher" 2>/dev/null || true
    "$TRUSTED_GATE_CGROUP" signal "$cgroup" KILL 2>/dev/null || true
    "$TRUSTED_GATE_CGROUP" remove "$cgroup" 2>/dev/null || true
    fail "не смог поместить $name в отдельную cgroup"
    return 1
  fi
  kill -CONT "$launcher" 2>/dev/null || return 1
  if wait_for_test_gate_handshake "$handshake" "$launcher" "$nonce" "$ack"; then
    gate_pgids[${#gate_pgids[@]}-1]=$gate_pgid
    gate_ready[${#gate_ready[@]}-1]=1
    return 0
  fi
  fail "не дождался handshake реальной session для $name"
  return 1
}

stop_test_gates() {
  local i launcher
  [ "$test_gates_stopped" = 0 ] || return 0
  test_gates_stopped=1
  for i in "${!gate_pids[@]}"; do
    launcher=${gate_pids[$i]}
    if [ "${gate_ready[$i]}" = 1 ]; then
      stop_ready_test_gate "$launcher" "${gate_pgids[$i]}" "${gate_cgroups[$i]}"
    else
      stop_unready_test_gate_launcher "$launcher"
      "$TRUSTED_GATE_CGROUP" signal "${gate_cgroups[$i]}" KILL 2>/dev/null || true
      wait_for_gate_cgroup_empty "${gate_cgroups[$i]}" || true
      "$TRUSTED_GATE_CGROUP" remove "${gate_cgroups[$i]}" 2>/dev/null || true
    fi
  done
}

wait_for_test_gates() {
  local launcher
  [ "$test_gates_reaped" = 0 ] || return 0
  for launcher in "${gate_pids[@]}"; do
    reap_test_gate_launcher "$launcher"
  done
  test_gates_reaped=1
}

drain_test_gate_group() { # drain_test_gate_group <launcher> <pgid> <cgroup>
  local launcher=$1 pgid=$2 cgroup=$3 group_clean=1 cgroup_clean=1
  if wait_for_test_gate_group_exit "$pgid"; then
    reap_test_gate_launcher "$launcher"
  else
    group_clean=0
    kill -TERM -- "-$pgid" 2>/dev/null || true
    if ! wait_for_test_gate_group_exit "$pgid"; then
      kill -KILL -- "-$pgid" 2>/dev/null || true
      wait_for_test_gate_group_exit "$pgid" || true
    fi
    reap_test_gate_launcher "$launcher"
  fi
  drain_gate_cgroup "$cgroup" || cgroup_clean=0
  [ "$group_clean" = 1 ] && [ "$cgroup_clean" = 1 ]
}

wait_for_test_gate_descendants() { # wait_for_test_gate_descendants <launcher> <pgid> <cgroup>
  local launcher=$1 pgid=$2 cgroup=$3
  if ! drain_test_gate_group "$launcher" "$pgid" "$cgroup"; then
    return 1
  fi
  while test_gate_group_alive "$pgid"; do
    "$TRUSTED_SLEEP" "$GATE_POLL_DELAY"
  done
}

print_test_gate_logs() {
  local i
  for i in "${!gate_logs[@]}"; do
    step "полный вывод: ${gate_names[$i]}"
    "$TRUSTED_CAT" "${gate_logs[$i]}"
  done
}

on_test_gate_signal() {
  local signal=$1
  trap - HUP INT TERM
  stop_test_gates
  wait_for_test_gates
  print_test_gate_logs
  cleanup
  exit 130
}

run_parallel_test_gates() {
  local completed status failed_name completed_index other_index
  gate_pids=()
  gate_pgids=()
  gate_ready=()
  gate_logs=()
  gate_names=()
  gate_cgroups=()
  test_gates_stopped=0
  test_gates_reaped=0

  # A shell started as a background job can inherit ignored SIGINT. Reset it
  # before installing our handler so INT follows the same cleanup path.
  trap - HUP INT TERM
  trap 'on_test_gate_signal HUP' HUP
  trap 'on_test_gate_signal INT' INT
  trap 'on_test_gate_signal TERM' TERM

  if ! start_test_gate "UI-проверки" "$work/ui-checks.log" "$work/ui-checks.session" \
    "$TRUSTED_ENV" PATH="$TRUSTED_PATH" "$TRUSTED_BASH" -c \
    'cd "$1" && "$2" "$3" tsc -p tsconfig.app.json --noEmit && "$2" "$4" test' \
    "$TRUSTED_BASH" "$source_dir/web" "$TRUSTED_NODE" "$TRUSTED_NPX_CLI" "$TRUSTED_NPM_CLI"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi
  if ! start_test_gate "Go-проверки, тесты пилота и сценарий выката" "$work/go-checks.log" "$work/go-checks.session" \
    "$TRUSTED_BASH" -c 'umask 077; cd "$1" && "$2" test ./... && "$3" -m unittest pilot.test_pilot && "$4" "$5"' \
    "$TRUSTED_BASH" "$source_dir" "$TRUSTED_GO" "$TRUSTED_PYTHON" "$TRUSTED_BASH" "$trusted_gate_script"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    return 1
  fi

  wait -n -p completed "${gate_pids[@]}"
  status=$?
  if [ "$status" -ne 0 ]; then
    failed_name="параллельная группа проверок"
    if [ "$completed" = "${gate_pids[0]}" ]; then failed_name="${gate_names[0]}"; fi
    if [ "$completed" = "${gate_pids[1]}" ]; then failed_name="${gate_names[1]}"; fi
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "$failed_name завершилась с кодом $status"
    return 1
  fi

  completed_index=1
  [ "$completed" = "${gate_pids[0]}" ] && completed_index=0
  if ! wait_for_test_gate_descendants "${gate_pids[$completed_index]}" "${gate_pgids[$completed_index]}" "${gate_cgroups[$completed_index]}"; then
    stop_test_gates
    wait_for_test_gates
    trap - HUP INT TERM
    print_test_gate_logs
    fail "не смог подтвердить завершение process group ${gate_names[$completed_index]}"
    return 1
  fi

  other_index=0
  [ "$completed_index" = 0 ] && other_index=1
  wait "${gate_pids[$other_index]}"
  status=$?
  if [ "$status" -eq 0 ] \
    && ! wait_for_test_gate_descendants "${gate_pids[$other_index]}" "${gate_pgids[$other_index]}" "${gate_cgroups[$other_index]}"; then
    status=1
  fi
  if [ "$status" -ne 0 ]; then
    stop_test_gates
    wait_for_test_gates
    fail "${gate_names[$other_index]} завершилась с кодом $status"
  fi
  trap - HUP INT TERM
  print_test_gate_logs
  if [ "$status" -eq 0 ]; then
    test_gates_stopped=1
    test_gates_reaped=1
  fi
  [ "$status" -eq 0 ]
}

step "беру исходники: $ref"
"$TRUSTED_MKDIR" -p "$TRUSTED_SOURCE_ROOT" \
  || { fail "не смог подготовить доверенный корень исходников"; cleanup; exit 4; }
trusted_root_owner=$("$TRUSTED_STAT" -Lc %u -- "$TRUSTED_SOURCE_ROOT" 2>/dev/null) \
  || { fail "не смог проверить доверенный корень исходников"; cleanup; exit 4; }
trusted_root_mode=$("$TRUSTED_STAT" -Lc %a -- "$TRUSTED_SOURCE_ROOT" 2>/dev/null) \
  || { fail "не смог проверить права доверенного корня исходников"; cleanup; exit 4; }
if [ ! -d "$TRUSTED_SOURCE_ROOT" ] || [ -L "$TRUSTED_SOURCE_ROOT" ] \
  || [ "$trusted_root_owner" != "$TRUSTED_OWNER_UID" ] \
  || (( (8#$trusted_root_mode & 0022) != 0 )); then
  fail "корень доверенного checkout доступен для изменения"
  cleanup
  exit 4
fi
trusted_work=$("$TRUSTED_MKTEMP" -d "$TRUSTED_SOURCE_ROOT/build-XXXXXX") \
  || { fail "не смог создать доверенный checkout"; cleanup; exit 4; }
"$TRUSTED_CHMOD" 0755 "$trusted_work" \
  || { fail "не смог открыть доверенный checkout для gate identity"; cleanup; exit 4; }
source_dir="$trusted_work/src"
"$TRUSTED_GIT" clone --quiet "$REPO" "$source_dir" \
  || { fail "не смог забрать репозиторий с GitHub"; cleanup; exit 4; }
"$TRUSTED_GIT" -C "$source_dir" checkout --quiet -B fx-build "origin/$ref" 2>/dev/null \
  || "$TRUSTED_GIT" -C "$source_dir" checkout --quiet "$ref" 2>/dev/null \
  || { fail "нет такой точки сборки: $ref"; cleanup; exit 4; }
trusted_gate_script="$source_dir/ops/test-fx-factory-release.sh"
case "$trusted_gate_script" in /*) ;; *) fail "gate script не имеет абсолютного пути"; cleanup; exit 4 ;; esac
gate_script_owner=$("$TRUSTED_STAT" -Lc %u -- "$trusted_gate_script" 2>/dev/null) \
  || { fail "не смог проверить gate script"; cleanup; exit 4; }
gate_script_mode=$("$TRUSTED_STAT" -Lc %a -- "$trusted_gate_script" 2>/dev/null) \
  || { fail "не смог проверить права gate script"; cleanup; exit 4; }
if [ ! -f "$trusted_gate_script" ] || [ -L "$trusted_gate_script" ] \
  || [ ! -r "$trusted_gate_script" ] || [ "$gate_script_owner" != "$TRUSTED_OWNER_UID" ] \
  || (( (8#$gate_script_mode & 0022) != 0 )); then
  fail "gate script не прошёл проверку доверенного пути"
  cleanup
  exit 4
fi

# Capture every mutable delivery target before bootstrap: a first release may
# create the helper, while an upgrade must be able to put its old copy back.
transaction_targets=(
  "$BROKER_BIN_TARGET" "$BROKER_UNIT_TARGET" "$BROKER_PILOT_DROPIN_TARGET" "$BROKER_LEGACY_DROPIN_TARGET"
  "$CONTROL_FX_TARGET" "$CONTROL_RELEASE_TARGET" "$TRUSTED_GATE_CGROUP"
)
transaction_existed=()
for ((transaction_i=0; transaction_i<${#transaction_targets[@]}; transaction_i++)); do
  transaction_target=${transaction_targets[$transaction_i]}
  if [ -e "$transaction_target" ] || [ -L "$transaction_target" ]; then
    "$TRUSTED_CP" -a -- "$transaction_target" "$work/transaction-$transaction_i.prev" \
      || { fail "не смог сохранить $transaction_target для отката"; cleanup; exit 4; }
    transaction_existed[$transaction_i]=1
  else
    transaction_existed[$transaction_i]=0
  fi
done

# A newly provisioned host has no helper yet.  Install it only from the
# root-owned, immutable checkout and validate the installed copy before the
# first Gate session can use it.
bootstrap_gate_cgroup="$source_dir/ops/factory-gate-cgroup"
if [ ! -f "$bootstrap_gate_cgroup" ] || [ -L "$bootstrap_gate_cgroup" ] \
  || [ "$("$TRUSTED_STAT" -Lc %u -- "$bootstrap_gate_cgroup" 2>/dev/null)" != "$TRUSTED_OWNER_UID" ]; then
  fail "cgroup-helper не прошёл проверку доверенного пути"
  cleanup
  exit 4
fi
if ! validate_trusted_executable "$TRUSTED_GATE_CGROUP"; then
  "$TRUSTED_INSTALL" -o root -g root -m 755 -- "$bootstrap_gate_cgroup" "$TRUSTED_GATE_CGROUP.new" \
    && "$TRUSTED_MV" -f -- "$TRUSTED_GATE_CGROUP.new" "$TRUSTED_GATE_CGROUP" \
    || { fail "не смог безопасно установить cgroup-helper до Gate"; cleanup; exit 4; }
fi
validate_trusted_executable "$TRUSTED_GATE_CGROUP" \
  || { fail "установленный cgroup-helper не является доверенным"; cleanup; exit 4; }
sha=$("$TRUSTED_GIT" -C "$source_dir" rev-parse HEAD)
subject=$("$TRUSTED_GIT" -C "$source_dir" log -1 --pretty=%s)
case "$subject" in
  "Merge pull request #"*)
    merged_title=$("$TRUSTED_GIT" -C "$source_dir" log -1 --pretty=%B \
      | "$TRUSTED_SED" '1d; /^[[:space:]]*$/d' | "$TRUSTED_HEAD" -n 1)
    [ -z "$merged_title" ] || subject=$merged_title
    ;;
esac
subject=$(printf '%s' "$subject" | "$TRUSTED_SED" -E 's/[[:space:]]+\(#[0-9]+\)$//')
[ -n "$subject" ] || subject="Обновление Factory"
step "собираю изменение: $subject"

step "ставлю зависимости интерфейса"
(
  cd "$source_dir/web" \
    && trusted_node "$TRUSTED_NPM_CLI" ci --ignore-scripts --no-audit --no-fund --silent \
    && printf 'module github.com/owainlewis/factory/web/node_modules\n\ngo 1.25\n' \
      >node_modules/go.mod
) \
  || { fail "npm ci не прошёл"; cleanup; exit 4; }
"$TRUSTED_GIT" -C "$source_dir" diff --quiet HEAD -- \
  || { fail "подготовка зависимостей изменила доверенный checkout"; cleanup; exit 4; }
"$TRUSTED_CHMOD" -R a-w "$source_dir" \
  || { fail "не смог заморозить доверенный checkout"; cleanup; exit 4; }
step "параллельно проверяю интерфейс, Go, пилота и сценарий выката"
run_parallel_test_gates \
  || { fail "одна из обязательных проверок не прошла — релиз не поеду"; cleanup; exit 5; }
step "собираю интерфейс"
(cd "$source_dir/web" && trusted_node "$TRUSTED_NPX_CLI" vite build) \
  || { fail "сборка интерфейса не прошла"; cleanup; exit 5; }
step "собираю сервер и воркер"
as_user "$TRUSTED_BASH" -c 'cd "$1" && "$2" build -o "$3" ./cmd/factory-server' \
    "$TRUSTED_BASH" "$source_dir" "$TRUSTED_GO" "$work/factory-server" \
  && as_user "$TRUSTED_BASH" -c 'cd "$1" && "$2" build -o "$3" ./cmd/factory-worker' \
    "$TRUSTED_BASH" "$source_dir" "$TRUSTED_GO" "$work/factory-worker" \
  && as_user "$TRUSTED_BASH" -c 'cd "$1" && "$2" build -o "$3" ./cmd/factory-release-broker' \
    "$TRUSTED_BASH" "$source_dir" "$TRUSTED_GO" "$work/factory-release-broker" \
  || { fail "сборка сервера, воркера или release-broker не прошла"; cleanup; exit 5; }

step "проверяю и обновляю ссылки авторизации Codex"
"$TRUSTED_ENV" -u CODEX_HOME "$TRUSTED_BASH" "$source_dir/ops/provision-codex-auth.sh" \
  || { fail "авторизация Codex не прошла безопасную проверку — релиз не поеду"; cleanup; exit 5; }

step "сохраняю работающую пару бинарей"
"$TRUSTED_CP" -f "$SERVER_BIN" "$work/factory-server.prev" \
  && "$TRUSTED_CP" -f "$WORKER_BIN" "$work/factory-worker.prev" \
  || { fail "не смог сохранить текущие сервер и воркер"; cleanup; exit 4; }

# Снимок release-info нужен до первой операции, которая может вызвать rollback:
# ранний отказ установки сервера, воркера, control-команд или brain не должен
# потерять корректные сведения о прежнем выпуске.
info_previous_exists=0
if [ -e "$INFO" ]; then
  "$TRUSTED_CP" -f "$INFO" "$work/release-info.prev" \
    || { fail "не смог сохранить прежние сведения о выпуске"; cleanup; exit 4; }
  info_previous_exists=1
fi

rollback() {
  trap - EXIT HUP INT TERM
  rollback_armed=0
  fail "$1 — возвращаю предыдущий выпуск целиком"
  "$TRUSTED_CP" -f "$work/factory-server.prev" "$SERVER_BIN.new" \
    && "$TRUSTED_MV" -f "$SERVER_BIN.new" "$SERVER_BIN"
  "$TRUSTED_CP" -f "$work/factory-worker.prev" "$WORKER_BIN.new" \
    && "$TRUSTED_MV" -f "$WORKER_BIN.new" "$WORKER_BIN"
  if [ "${info_previous_exists:-0}" = 1 ]; then
    "$TRUSTED_CP" -f "$work/release-info.prev" "$INFO.new" \
      && "$TRUSTED_MV" -f "$INFO.new" "$INFO"
  else
    "$TRUSTED_RM" -f "$INFO"
  fi
  for ((transaction_i=${#transaction_targets[@]}-1; transaction_i>=0; transaction_i--)); do
    transaction_target=${transaction_targets[$transaction_i]}
    if [ "${transaction_existed[$transaction_i]}" = 1 ]; then
      "$TRUSTED_RM" -f -- "$transaction_target"
      "$TRUSTED_MV" -f -- "$work/transaction-$transaction_i.prev" "$transaction_target"
    else
      "$TRUSTED_RM" -f -- "$transaction_target"
    fi
  done
  "$TRUSTED_SYSTEMCTL" daemon-reload || true
  "$TRUSTED_SYSTEMCTL" restart factory-release-broker.service || true
  "$TRUSTED_SYSTEMCTL" restart "$PILOT_SERVICE" || true
  "$TRUSTED_SYSTEMCTL" restart "$SERVER_SERVICE" || true
  restart_workers || true
  cleanup
  exit "$2"
}

rollback_armed=1
on_exit() {
  status=$?
  [ "$rollback_armed" = 1 ] || return
  [ "$status" -ne 0 ] || status=130
  rollback "выпуск прерван до подтверждения новой пары" "$status"
}
on_signal() { rollback "выпуск прерван сигналом $1" 130; }
trap on_exit EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

install_binary() {
  source=$1 target=$2
  "$TRUSTED_CP" -f "$source" "$target.new" && set_owner "$target.new" \
    && "$TRUSTED_CHMOD" 755 "$target.new" && "$TRUSTED_MV" -f "$target.new" "$target"
}

step "ставлю новую пару и перезапускаю сервер"
install_binary "$work/factory-server" "$SERVER_BIN" || rollback "не смог поставить сервер" 4
install_binary "$work/factory-worker" "$WORKER_BIN" || rollback "не смог поставить воркер" 4
"$TRUSTED_SYSTEMCTL" restart "$SERVER_SERVICE" || rollback "сервер не перезапустился" 6
"$TRUSTED_SLEEP" 5

code=$("$TRUSTED_CURL" -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)
[ "$code" = "200" ] || rollback "после перезапуска Фабрика отвечает $code" 6

stop_workers || rollback "воркеры не остановились" 6
worker_id=''
identity_error="$work/worker-identity-error"
identity_attempt=1
while [ "$identity_attempt" -le 5 ]; do
  if worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>"$identity_error") \
    && [ -n "$worker_id" ]; then
    break
  fi
  worker_id=''
  identity_attempt=$((identity_attempt + 1))
  [ "$identity_attempt" -gt 5 ] || "$TRUSTED_SLEEP" 1
done
if [ -z "$worker_id" ]; then
  identity_detail=$("$TRUSTED_TR" '\n' ' ' <"$identity_error" | "$TRUSTED_CUT" -c1-300)
  [ -z "$identity_detail" ] || fail "причина identity: $identity_detail"
  rollback "не удалось определить identity воркера после пяти попыток" 6
fi
previous_body=$("$TRUSTED_CURL" -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
previous_heartbeat=$(printf '%s' "$previous_body" | "$TRUSTED_PYTHON" -c \
  'import json,sys
try: print(json.load(sys.stdin).get("last_heartbeat", ""))
except Exception: print("")' 2>/dev/null)
start_workers || rollback "воркеры не запустились" 6

step "жду здоровую регистрацию воркера $worker_id"
registered=0
attempt=1
while [ "$attempt" -le "$REGISTER_ATTEMPTS" ]; do
  body=$("$TRUSTED_CURL" -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
  if printf '%s' "$body" | "$TRUSTED_PYTHON" -c \
    'import datetime,json,sys
try:
 w=json.load(sys.stdin); current=w.get("last_heartbeat", "")
 fresh=bool(current) and (not sys.argv[2] or datetime.datetime.fromisoformat(current.replace("Z", "+00:00")) > datetime.datetime.fromisoformat(sys.argv[2].replace("Z", "+00:00")))
 ok=w.get("id") == sys.argv[1] and w.get("health") == "healthy" and w.get("online") is True and fresh
except Exception: ok=False
raise SystemExit(not ok)' \
    "$worker_id" "$previous_heartbeat" 2>/dev/null; then
    registered=1
    break
  fi
  attempt=$((attempt + 1))
  [ "$attempt" -gt "$REGISTER_ATTEMPTS" ] || "$TRUSTED_SLEEP" "$REGISTER_DELAY"
done
[ "$registered" = 1 ] || rollback "воркер $worker_id не зарегистрировался здоровым" 6

step "ставлю привилегированный broker выпусков"
"$TRUSTED_BASH" "$source_dir/ops/install-project-release-broker.sh" \
  "$work/factory-release-broker" "$source_dir/ops/systemd/factory-release-broker.service" \
  || rollback "release-broker не установлен безопасно" 7

step "обновляю штатные команды управления Фабрикой"
"$TRUSTED_BASH" "$source_dir/ops/install-factory-control.sh" "$source_dir" \
  || rollback "не смог обновить fx и драйвер выпуска" 7

deferred_pilot_restart=0
brain_restart_marker="$work/restart-pilot"
if [ -x "$source_dir/ops/install-brain.sh" ]; then
    FACTORY_BRAIN_DEFER_PILOT_RESTART=1 \
    FACTORY_BRAIN_RESTART_MARKER="$brain_restart_marker" \
    "$TRUSTED_BASH" "$source_dir/ops/install-brain.sh" "$source_dir" \
    || rollback "мозг не встал" 7
  [ ! -f "$brain_restart_marker" ] || deferred_pilot_restart=1
fi
if [ -f "$source_dir/ops/factory-janitor.sh" ]; then
  janitor_bin="${FACTORY_JANITOR_BIN:-/usr/local/bin/factory-janitor.sh}"
  "$TRUSTED_INSTALL" -o root -g root -m 755 "$source_dir/ops/factory-janitor.sh" "$janitor_bin" \
    || fail "санитар воркеров не обновился — сервер и воркер уже обновлены"
fi

step "ставлю и проверяю изолированный серверный браузер"
"$TRUSTED_BASH" "$source_dir/ops/install-server-browser.sh" \
  || rollback "серверный браузер не прошёл сетевую проверку" 7

if ! "$TRUSTED_PYTHON" - "$INFO" "$sha" "$subject" "$ref" "$("$TRUSTED_DATE" -Is)" <<'PY'
import json, sys, datetime
p, sha, subj, ref, iso = sys.argv[1:6]
M = ["января","февраля","марта","апреля","мая","июня",
     "июля","августа","сентября","октября","ноября","декабря"]
d = datetime.datetime.fromisoformat(iso)
when = "%d %s, %02d:%02d" % (d.day, M[d.month - 1], d.hour, d.minute)
json.dump({"name": "релиз от %s, из %s: %s" % (when, ref, subj),
           "sha": sha, "short": sha[:7], "ref": ref,
           "subject": subj, "when": when, "at": iso},
          open(p, "w"), ensure_ascii=False, indent=2)
print("== выкачено: релиз от %s, из %s: %s" % (when, ref, subj))
PY
then
  rollback "не смог записать сведения о выпуске" 7
fi
set_owner "$INFO" 2>/dev/null || true

if [ "$deferred_pilot_restart" = 1 ]; then
  step "ставлю безопасный отложенный перезапуск Пилота"
  "$TRUSTED_SYSTEMD_RUN" --quiet --collect --unit="factory-pilot-restart-$$" --on-active=30s \
    /usr/bin/flock -n "$LOCK" /bin/systemctl restart "$PILOT_SERVICE" \
    || rollback "не смог отложить перезапуск Пилота" 7
fi

rollback_armed=0
cleanup
"$TRUSTED_LS" -1dt "$REL"/build-* 2>/dev/null | "$TRUSTED_TAIL" -n +3 | "$TRUSTED_XARGS" -r "$TRUSTED_RM" -rf --
exit 0
