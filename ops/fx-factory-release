done
current_sha=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha"])' "$INFO" 2>/dev/null) \
  || { fail "неизвестная версия: release-info не содержит SHA"; cleanup; exit 4; }
