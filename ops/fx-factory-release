 s,t,m,o=line.rstrip("\n").split("\t"); b=open(os.path.join(root,s),"rb").read(); items.append({"source":s,"target":t,"mode":int(m,8),"owner":o,"size":len(b),"sha256":hashlib.sha256(b).hexdigest()})
proc=[]
