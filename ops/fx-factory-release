step "останавливаю прежний комплект и атомарно ставлю согласованную пару"
stop_factory_units || rollback "службы не остановились" 6
write_journal old-stopped "$generation_path" "$old_generation" || rollback "journal не записан" 4
install_generation "$generation_path" || rollback "полный комплект не установлен" 4
write_journal pair-installed "$generation_path" "$old_generation" || rollback "journal не записан" 4
systemctl start "$SERVER_SERVICE" || rollback "сервер не стартовал" 6
sleep 5
code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "$API/api/v1/dashboard" || echo 000)
[ "$code" = 200 ] || rollback "health нового сервера: HTTP $code" 6
worker_id=''
for identity_attempt in 1 2 3 4 5; do
  worker_id=$("$WORKER_BIN" identity -config "$WORKER_CONFIG" 2>/dev/null) && [ -n "$worker_id" ] && break
  worker_id=''; sleep 1
done
[ -n "$worker_id" ] || rollback "не определена identity воркера" 6
previous_body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
previous_heartbeat=$(printf '%s' "$previous_body" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("last_heartbeat",""))' 2>/dev/null || true)
start_workers || rollback "воркеры не стартовали" 6
registered=0
for ((attempt=1; attempt<=REGISTER_ATTEMPTS; attempt++)); do
  body=$(curl -fsS --max-time 10 "$API/api/v1/workers/$worker_id" 2>/dev/null || true)
  if printf '%s' "$body" | python3 -c 'import datetime,json,sys
try:
 w=json.load(sys.stdin); h=w.get("last_heartbeat",""); old=sys.argv[2]
 ok=w.get("id")==sys.argv[1] and w.get("health")=="healthy" and w.get("online") is True and h and (not old or h>old)
except Exception: ok=False
raise SystemExit(not ok)' "$worker_id" "$previous_heartbeat" 2>/dev/null; then registered=1; break; fi
  sleep "$REGISTER_DELAY"
done
[ "$registered" = 1 ] || rollback "нет свежей healthy-регистрации воркера $worker_id" 6
for pair in "$SERVER_SERVICE:$SERVER_BIN:$generation_path/payload/factory-server"; do
  unit=${pair%%:*}; rest=${pair#*:}; installed=${rest%%:*}; expected=${rest#*:}
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
  [ "$exe" = "$installed" ] && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$expected" | awk '{print $1}')" ] \
    || rollback "реально запущенный $unit не совпадает с manifest" 6
done
for unit in $(worker_service_list); do
  systemctl -q is-active "$unit" 2>/dev/null || continue
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
  [ "$exe" = "$WORKER_BIN" ] && [ "$(sha256sum "$exe" | awk '{print $1}')" = "$(sha256sum "$generation_path/payload/factory-worker" | awk '{print $1}')" ] \
    || rollback "реально запущенный $unit не совпадает с manifest" 6
done
restore_service_state "$generation_path/services.tsv" || rollback "состояния служб не восстановлены" 6
write_journal services-started "$generation_path" "$old_generation" || rollback "journal не записан" 4

cp -f "$generation_path/release-info.json" "$INFO.new" && set_owner "$INFO.new" && chmod 600 "$INFO.new" \
  && sync_path "$INFO.new" && mv -f "$INFO.new" "$INFO" && sync_path "$(dirname "$INFO")" \
  || rollback "правдивые metadata не опубликованы" 7
ln -sfn "$old_generation" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"
ln -sfn "$generation_path" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
write_journal committed "$generation_path" "$old_generation" || rollback "commit journal не записан" 7
rollback_armed=0
rm -f "$JOURNAL"; sync_path "$REL"
cleanup

# Retention runs only after commit and always protects current, previous and all
# pre-027 snapshots. Two complete generations and fourteen days are minimums.
current_real=$(readlink -f "$CURRENT"); previous_real=$(readlink -f "$PREVIOUS")
while read -r candidate; do
  [ "$candidate" != "$current_real" ] || continue
  [ "$candidate" != "$previous_real" ] || continue
  if [ -e "$candidate/database.sqlite3" ] \
    && [ "$(database_ledger "$candidate/database.sqlite3" 2>/dev/null || echo 999999)" -lt 27 ]; then
    continue
  fi
  verify_generation "$candidate" || continue
  if find "$candidate" -maxdepth 0 -mtime +14 -print -quit | grep -q .; then
    rm -rf -- "$candidate"
    echo "== retention: удалено проверенное поколение старше 14 дней: $(basename "$candidate")"
  fi
done < <(find "$GENERATIONS" -mindepth 1 -maxdepth 1 -type d -print)
echo "== выкачено: $subject; current=$sha previous=$current_sha snapshot=$(basename "$generation_path")/database.sqlite3 manifest=$(manifest_hash "$generation_path")"
exit 0
