#!/bin/bash
# Playwright-compatible entry point. The root helper applies the systemd BPF
# network allowlist and then drops back to the Factory account.
set -euo pipefail

if [ "$(id -u)" -eq 0 ]; then
  echo "Factory browser must not run as root" >&2
  exit 1
fi

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
helper=$(dirname "$SCRIPT")/factory-browser-isolated
[ -x "$helper" ] || { echo "Factory browser isolation helper was not found" >&2; exit 1; }
# Playwright uses descriptors 3 and 4 for its debugging pipe. The matching
# sudoers rule enables closefrom_override so those descriptors survive sudo.
exec sudo -n -C 5 "$helper" "$@"
