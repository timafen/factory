#!/bin/bash
# Root-only cgroup v2 containment primitive for Factory release gates.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

CGROUP_ROOT=/sys/fs/cgroup/factory-release-gates
MKDIR=/usr/bin/mkdir
RMDIR=/usr/bin/rmdir
READLINK=/usr/bin/readlink
STAT=/usr/bin/stat

fail() { printf 'factory-gate-cgroup: %s\n' "$*" >&2; exit 1; }

[ "$(/usr/bin/id -u)" = 0 ] || fail 'root is required'
[ "$("$STAT" -fc %T /sys/fs/cgroup)" = cgroup2fs ] || fail 'cgroup v2 is required'

name=${2:-}
case "$name" in ''|.|..|*/*|*\\*|*[!a-zA-Z0-9_.-]*) fail 'invalid cgroup name' ;; esac

prepare_root() {
  local owner mode
  "$MKDIR" -p -- "$CGROUP_ROOT"
  cgroup_root=$("$READLINK" -f -- "$CGROUP_ROOT") || fail 'cannot canonicalize cgroup root'
  [ "$cgroup_root" = "$CGROUP_ROOT" ] || fail 'cgroup root is not canonical'
  owner=$("$STAT" -Lc %u -- "$cgroup_root") || fail 'cannot inspect cgroup root'
  mode=$("$STAT" -Lc %a -- "$cgroup_root") || fail 'cannot inspect cgroup root'
  [ "$owner" = 0 ] && (( (8#$mode & 0022) == 0 )) || fail 'cgroup root is not root-owned'
}

prepare_group() {
  local canonical
  canonical=$("$READLINK" -f -- "$CGROUP_ROOT/$name") || fail 'cannot canonicalize cgroup'
  case "$canonical" in "$cgroup_root"/*) ;; *) fail 'cgroup escapes owned root' ;; esac
  [ "$canonical" != "$cgroup_root" ] || fail 'cgroup must be below owned root'
  group=$canonical
}

prepare_root

case "${1:-}" in
  create)
    "$MKDIR" -- "$CGROUP_ROOT/$name"
    prepare_group
    ;;
  attach)
    prepare_group
    case "${3:-}" in ''|*[!0-9]*) fail 'invalid pid' ;; esac
    printf '%s\n' "$3" >"$group/cgroup.procs"
    ;;
  pids)
    prepare_group
    [ -r "$group/cgroup.procs" ] || fail 'cgroup does not exist'
    /usr/bin/sort -n -u -- "$group/cgroup.procs"
    ;;
  empty)
    prepare_group
    [ -r "$group/cgroup.procs" ] || exit 1
    pid=
    IFS= read -r pid <"$group/cgroup.procs" || true
    [ -z "$pid" ]
    ;;
  signal)
    prepare_group
    signal=${3:-}
    case "$signal" in
      TERM)
        while IFS= read -r pid; do
          case "$pid" in ''|*[!0-9]*) continue ;; esac
          kill -TERM "$pid" 2>/dev/null || true
        done <"$group/cgroup.procs"
        ;;
      KILL)
        if [ -w "$group/cgroup.kill" ]; then
          printf '1\n' >"$group/cgroup.kill"
        else
          while IFS= read -r pid; do
            case "$pid" in ''|*[!0-9]*) continue ;; esac
            kill -KILL "$pid" 2>/dev/null || true
          done <"$group/cgroup.procs"
        fi
        ;;
      *) fail 'invalid signal' ;;
    esac
    ;;
  remove)
    prepare_group
    "$RMDIR" -- "$group"
    ;;
  *) fail 'usage: factory-gate-cgroup create|attach|pids|empty|signal|remove NAME [ARG]' ;;
esac
