[Unit]
Description=Factory privileged project release broker
Before=factory-server.service

[Service]
Type=simple
User=root
Group=factory-release
RuntimeDirectory=factory
RuntimeDirectoryMode=0750
StateDirectory=factory/release-broker factory/release-deliveries
StateDirectoryMode=0700
UMask=0007
ExecStart=/opt/factory-data/bin/factory-release-broker --state-dir /var/lib/factory/release-broker --live-acceptance-executable /usr/local/lib/factory-live-acceptance
Restart=on-failure
RestartSec=2
# NoNewPrivileges здесь НЕЛЬЗЯ: в сочетании с PrivateTmp/PrivateDevices/Protect*
# systemd лишает root CAP_SETUID, и выпуск не может понизиться до factory
# (падали sudo и setpriv: «setresuid failed»). Остальная изоляция сохранена.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
